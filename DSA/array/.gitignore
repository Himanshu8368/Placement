# rough notes stay untracked; only the array book's sources are tracked
/notes/*
!/notes/array_book/

# array book build outputs
/notes/array_book/**/*.aux
/notes/array_book/**/*.log
/notes/array_book/**/*.out
/notes/array_book/**/*.toc
/notes/array_book/**/*.pdf
/notes/array_book/**/*.synctex.gz
/notes/array_book/**/*.fls
/notes/array_book/**/*.fdb_latexmk
/notes/array_book/**/*.exe
/notes/array_book/**/__pycache__/
/notes/array_book/tools/.lc_slugs.json
