\@writefile{lof}{\contentsline {figure}{\numberline {29.0.1}{\ignorespaces Chapter~29 on the six-step ladder: hand-running the bridge test on the running graph is \(\textcolor {lv3}{\textbf  {L3}}\); the coded contraction and CF 118E, and reading functional/cactus graphs, are \(\textcolor {lv4}{\textbf  {L4}}\); the edge-stack block pop and CF 962F are \(\textcolor {lv5}{\textbf  {L5}}\); the Summit (CF 835F, delete one cycle edge to minimise the tree diameter) is step~6.}}{1709}{figure.caption.289}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {29.0.2}{\ignorespaces The running graph \(G\): triangles \(B_1=\{1,2,3\}\) and \(B_2=\{4,5,6\}\) in blue, joined by the red bridge \(3\!-\!4\), with the red pendant path \(4\!-\!7\!-\!8\!-\!9\). Articulation points (orange) are \(3,4,7,8\). The bridge tree contracts \(B_1,B_2,\{7\},\{8\},\{9\}\) to the path \(B_1\!-\!B_2\!-\!7\!-\!8\!-\!9\); the block-cut tree is traced in \(\S  \ref {sec:c31-block}\).}}{1710}{figure.caption.290}\protected@file@percent }
\newlabel{fig:c31-graph}{{29.0.2}{1710}{The running graph \(G\): triangles \(B_1=\{1,2,3\}\) and \(B_2=\{4,5,6\}\) in blue, joined by the red bridge \(3\!-\!4\), with the red pendant path \(4\!-\!7\!-\!8\!-\!9\). Articulation points (orange) are \(3,4,7,8\). The bridge tree contracts \(B_1,B_2,\{7\},\{8\},\{9\}\) to the path \(B_1\!-\!B_2\!-\!7\!-\!8\!-\!9\); the block-cut tree is traced in \(\secref {c31-block}\)}{figure.caption.290}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {29.0.3}{\ignorespaces The bridge tree of \(G\): contract every 2-edge-connected component to a node; the bridges become the tree edges. It is a tree precisely \emph  {because} every remaining connection was a bridge -- the object Chapters 12/13 let you DP on.}}{1710}{figure.caption.291}\protected@file@percent }
\newlabel{fig:c31-bridgetree}{{29.0.3}{1710}{The bridge tree of \(G\): contract every 2-edge-connected component to a node; the bridges become the tree edges. It is a tree precisely \emph {because} every remaining connection was a bridge -- the object Chapters 12/13 let you DP on}{figure.caption.291}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {29.0.4}{\ignorespaces Where the four decompositions sit. A functional graph is already directed and out-degree one \(\to \) rho pieces (\(\S  \ref {sec:c31-functional}\)). An undirected graph: kill \emph  {edge} redundancy \(\to \) bridge tree (\(\S  \ref {sec:c31-bridges}\)); kill \emph  {vertex} redundancy \(\to \) block-cut tree (\(\S  \ref {sec:c31-block}\)); if cycles never share an edge the two coincide into the cactus (\(\S  \ref {sec:c31-cactus}\)).}}{1711}{figure.caption.292}\protected@file@percent }
\newlabel{fig:c31-taxonomy}{{29.0.4}{1711}{Where the four decompositions sit. A functional graph is already directed and out-degree one \(\to \) rho pieces (\(\secref {c31-functional}\)). An undirected graph: kill \emph {edge} redundancy \(\to \) bridge tree (\(\secref {c31-bridges}\)); kill \emph {vertex} redundancy \(\to \) block-cut tree (\(\secref {c31-block}\)); if cycles never share an edge the two coincide into the cactus (\(\secref {c31-cactus}\))}{figure.caption.292}{}}
