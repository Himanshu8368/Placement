\@writefile{toc}{\contentsline {subsection}{\numberline {10.2.1}Intuition}{608}{subsection.10.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.2.1}{\ignorespaces Floyd's bottom-up heapify turns the raw array $R=(5,3,8,1,4,2,7)$ into the min-heap $(1,3,2,5,4,8,7)$ by sifting \emph  {only the internal nodes}, from index $\lfloor n/2\rfloor $ up to the root. Leaves are already (trivial) heaps; each sift-down merges two finished heaps plus one new value. The expensive move happens once, at the root, which is why the total is $\ensuremath  {O(n)}$ (Theorem~\ref {thm:c07-floyd}, Example~\ref {ex:c07-build-run}).}}{609}{figure.caption.105}\protected@file@percent }
\newlabel{fig:c07-buildfig}{{10.2.1}{609}{Floyd's bottom-up heapify turns the raw array $R=(5,3,8,1,4,2,7)$ into the min-heap $(1,3,2,5,4,8,7)$ by sifting \emph {only the internal nodes}, from index $\lfloor n/2\rfloor $ up to the root. Leaves are already (trivial) heaps; each sift-down merges two finished heaps plus one new value. The expensive move happens once, at the root, which is why the total is $\bigO {n}$ (\thmref {c07-floyd}, \exref {c07-build-run})}{figure.caption.105}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.2.2}The $\ensuremath  {O(n)}$ Build}{609}{subsection.10.2.2}\protected@file@percent }
