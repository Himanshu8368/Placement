\@writefile{toc}{\contentsline {subsection}{\numberline {10.4.1}Intuition: The Heap as an Output Scheduler}{627}{subsection.10.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.4.1}{\ignorespaces Multiway merge of the three lists $(1,4,5),(1,3,4),(2,6)$ -- LeetCode 23's first sample. Only the \emph  {current head} of each list enters the min-heap (highlighted heads). The heap \texttt  {pop}s the global smallest head (here a $1$), it is appended to the output, and \emph  {that list's} successor is pushed back, so the heap always holds exactly one candidate per non-exhausted list. $N$ outputs cost $\ensuremath  {O(N\log k)}$. }}{627}{figure.caption.107}\protected@file@percent }
\newlabel{fig:c07-multimerge}{{10.4.1}{627}{Multiway merge of the three lists $(1,4,5),(1,3,4),(2,6)$ -- LeetCode 23's first sample. Only the \emph {current head} of each list enters the min-heap (highlighted heads). The heap \code {pop}s the global smallest head (here a $1$), it is appended to the output, and \emph {that list's} successor is pushed back, so the heap always holds exactly one candidate per non-exhausted list. $N$ outputs cost $\bigO {N\log k}$}{figure.caption.107}{}}
