\newlabel{sec:c07-trees}{{10.3}{616}{Mergeable Heaps: Heaps You Can Union}{section.10.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.3.1}Intuition}{617}{subsection.10.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.3.1}{\ignorespaces A leftist min-heap on the values $\{1,2,4,9\}$ (the output of Example~\ref {ex:c07-merge-run}). It is \emph  {heap-ordered} ($1\le 4,2$; $2\le 9$) and \emph  {leftist}: at each node the left child's null-path length is $\ge $ the right child's, so $\mathit  {npl}$ is written beside each node. All the emptiness sits on the highlighted right spine, which has length $\le \lg (n+1)$ -- that spine is the only path a merge touches, so merge costs $\ensuremath  {O(\log n)}$ (Theorem~\ref {thm:c07-leftist}) even though the left subtree could be arbitrarily tall.}}{618}{figure.caption.106}\protected@file@percent }
\newlabel{fig:c07-leftistfig}{{10.3.1}{618}{A leftist min-heap on the values $\{1,2,4,9\}$ (the output of \exref {c07-merge-run}). It is \emph {heap-ordered} ($1\le 4,2$; $2\le 9$) and \emph {leftist}: at each node the left child's null-path length is $\ge $ the right child's, so $\mathit {npl}$ is written beside each node. All the emptiness sits on the highlighted right spine, which has length $\le \lg (n+1)$ -- that spine is the only path a merge touches, so merge costs $\bigO {\log n}$ (\thmref {c07-leftist}) even though the left subtree could be arbitrarily tall}{figure.caption.106}{}}
