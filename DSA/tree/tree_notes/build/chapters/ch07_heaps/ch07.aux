\@writefile{lof}{\contentsline {figure}{\numberline {10.0.1}{\ignorespaces The index layout a heap exploits. A complete binary tree of $n$ nodes fills positions $1..n$ with no gaps, so a child is reachable by $2i,2i+1$ and a parent by $\lfloor i/2\rfloor $ -- the whole structure is one array and integer arithmetic (\S  \ref {sec:c07-heap}). This shape is fixed: a heap is never rebalanced by rotations, only \emph  {refilled} at the last slot.}}{595}{figure.caption.101}\protected@file@percent }
\newlabel{fig:c07-layout}{{10.0.1}{595}{The index layout a heap exploits. A complete binary tree of $n$ nodes fills positions $1..n$ with no gaps, so a child is reachable by $2i,2i+1$ and a parent by $\lfloor i/2\rfloor $ -- the whole structure is one array and integer arithmetic (\secref {c07-heap}). This shape is fixed: a heap is never rebalanced by rotations, only \emph {refilled} at the last slot}{figure.caption.101}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.0.2}{\ignorespaces Array $R=(5,3,8,1,4,2,7)$ after Floyd build, as the min-heap $(1,3,2,5,4,8,7)$. The root $1$ is the minimum and every parent is $\le $ its children, but the two children of the root are $3$ and $2$ -- \emph  {out of order}. A heap guarantees only ``parent beats children''; the left-to-right reading is meaningless, which is exactly what separates it from the BST of Chapter~7 and the Cartesian tree of Chapter~9 (\S  \ref {sec:c07-heap}).}}{595}{figure.caption.102}\protected@file@percent }
\newlabel{fig:c07-heapR}{{10.0.2}{595}{Array $R=(5,3,8,1,4,2,7)$ after Floyd build, as the min-heap $(1,3,2,5,4,8,7)$. The root $1$ is the minimum and every parent is $\le $ its children, but the two children of the root are $3$ and $2$ -- \emph {out of order}. A heap guarantees only ``parent beats children''; the left-to-right reading is meaningless, which is exactly what separates it from the BST of Chapter~7 and the Cartesian tree of Chapter~9 (\secref {c07-heap})}{figure.caption.102}{}}
