\newlabel{ex:c10-k2}{{13.4.3}{809}{The $k=2$ distance-pair census on $T$, degenerate rows flagged}{tcb@cnt@definition.13.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13.4.1}{\ignorespaces The $k=2$ census on $T$: $7$ degenerate rows riding on $\ell $ itself, $3$ strict cross-child rows, total $10$. Peaks $4,5,6,8,9,10$ carry no $k=2$ row: $5$ and $7$ each have a single child, so no cross-child pair at distance~$2$ fits; the leaves have no depth-$2$ descendant at all. Every row with a bold ``yes'' is one the LCA \emph  {ancestor-of} case licenses (Ch.16's Proposition~\ref {prop:c11-chain}: if $u\preceq v$ then $\lca  (u,v)=u$).}}{809}{table.caption.136}\protected@file@percent }
\newlabel{tab:c10-k2-table}{{13.4.1}{809}{The $k=2$ census on $T$: $7$ degenerate rows riding on $\ell $ itself, $3$ strict cross-child rows, total $10$. Peaks $4,5,6,8,9,10$ carry no $k=2$ row: $5$ and $7$ each have a single child, so no cross-child pair at distance~$2$ fits; the leaves have no depth-$2$ descendant at all. Every row with a bold ``yes'' is one the LCA \emph {ancestor-of} case licenses (Ch.16's \propref {c11-chain}: if $u\preceq v$ then $\lca (u,v)=u$)}{table.caption.136}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13.4.1}{\ignorespaces The $k=2$ census drawn on $T$. Every orange edge-chain $\ell \to \cdots  \to w$ with $\mathit  {len}=2$ is a degenerate row (arm of length~$0$ at $\ell $, endpoint $\ell $ itself); every green two-edge splay $\{c_1, c_2\}$ at $\ell $ is a strict cross-child row. Peaks $4,5,6,8,9,10$ are unmarked -- no $k=2$ pair files there. This figure is the one Ch.16's Example~\ref {ex:c11-census} cites by name when it flags the ancestor-of case.}}{810}{figure.caption.137}\protected@file@percent }
\newlabel{fig:c10-distk}{{13.4.1}{810}{The $k=2$ census drawn on $T$. Every orange edge-chain $\ell \to \cdots \to w$ with $\mathit {len}=2$ is a degenerate row (arm of length~$0$ at $\ell $, endpoint $\ell $ itself); every green two-edge splay $\{c_1, c_2\}$ at $\ell $ is a strict cross-child row. Peaks $4,5,6,8,9,10$ are unmarked -- no $k=2$ pair files there. This figure is the one Ch.16's \exref {c11-census} cites by name when it flags the ancestor-of case}{figure.caption.137}{}}
