\@writefile{lof}{\contentsline {figure}{\numberline {13.0.1}{\ignorespaces The running tree $T$ \emph  {with its in/out DP overlay}. Rooted at $1$, the two-state MIS recurrence (Theorem~\ref {thm:c10-mis-tree}) computes $\mathit  {dp}_{\mathit  {in}}[v] = 1 + \DOTSB \sum@ \slimits@ _{c}\mathit  {dp}_{\mathit  {out}}[c]$ and $\mathit  {dp}_{\mathit  {out}}[v] = \DOTSB \sum@ \slimits@ _c \max (\mathit  {dp}_{\mathit  {in}}[c],\mathit  {dp}_{\mathit  {out}}[c])$ in a single post-order DFS -- the same table every section of this chapter reuses. Peak census and distance-$2$ census on this picture live in \S  \ref {sec:c10-harvest} and Example~\ref {ex:c10-k2}.}}{773}{figure.caption.125}\protected@file@percent }
\newlabel{fig:c10-runtree-dp}{{13.0.1}{773}{The running tree $T$ \emph {with its in/out DP overlay}. Rooted at $1$, the two-state MIS recurrence (\thmref {c10-mis-tree}) computes $\mathit {dp}_{\mathit {in}}[v] = 1 + \sum _{c}\mathit {dp}_{\mathit {out}}[c]$ and $\mathit {dp}_{\mathit {out}}[v] = \sum _c \max (\mathit {dp}_{\mathit {in}}[c],\mathit {dp}_{\mathit {out}}[c])$ in a single post-order DFS -- the same table every section of this chapter reuses. Peak census and distance-$2$ census on this picture live in \secref {c10-harvest} and \exref {c10-k2}}{figure.caption.125}{}}
