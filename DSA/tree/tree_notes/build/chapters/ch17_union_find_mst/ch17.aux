\newlabel{lst:c17-kruskal}{{31.1.1}{1808}{Kruskal MST. Sort edges by weight, then union the endpoints, accumulating an edge exactly when its two endpoints were in different components. Uses the Ch.17 DSU. Returns the MST weight and fills the parent structure; total cost is dominated by the sort}{lstlisting.31.1.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.1.1}{\ignorespaces Kruskal MST. Sort edges by weight, then union the endpoints, accumulating an edge exactly when its two endpoints were in different components. Uses the Ch.17 DSU. Returns the MST weight and fills the parent structure; total cost is dominated by the sort}}{1808}{lstlisting.31.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31.1.1}{\ignorespaces The Kruskal trace on \(G\). The three dashed edges each close a cycle where they are the heaviest member, so \(Lemma~\ref {lem:c17-safe}\) rejects them; the four solid edges are exactly \(Figure~\ref {fig:c17-tree}\)'s MST.}}{1809}{figure.caption.312}\protected@file@percent }
\newlabel{fig:c17-kruskal-trace}{{31.1.1}{1809}{The Kruskal trace on \(G\). The three dashed edges each close a cycle where they are the heaviest member, so \(\lemref {c17-safe}\) rejects them; the four solid edges are exactly \(\figref {c17-tree}\)'s MST}{figure.caption.312}{}}
