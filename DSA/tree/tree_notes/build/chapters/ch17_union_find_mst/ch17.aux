\newlabel{prob:c17-connect}{{31.1.1}{1810}{Solved: CF 1095F -- Make It Connected (1900, L4)}{solvedprob.31.1.1}{}}
\@writefile{lop}{\contentsline {problem}{\numberline {W31.1.1}Make It Connected~--~CF 1095F}{1810}{solvedprob.31.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31.1.2}{\ignorespaces The reduction. Only two families of edges can be in the MST: the \(n-1\) star edges to the cheapest city \(s\), and the \(m\) offers. Every other regular road \((x,y)\) is dominated by \(x\!-\!s\) or \(y\!-\!s\) and is safely discarded before Kruskal runs on \(O(n+m)\) edges.}}{1810}{figure.caption.313}\protected@file@percent }
\newlabel{fig:c17-connect}{{31.1.2}{1810}{The reduction. Only two families of edges can be in the MST: the \(n-1\) star edges to the cheapest city \(s\), and the \(m\) offers. Every other regular road \((x,y)\) is dominated by \(x\!-\!s\) or \(y\!-\!s\) and is safely discarded before Kruskal runs on \(O(n+m)\) edges}{figure.caption.313}{}}
\newlabel{lst:c17-connect}{{31.1.2}{1812}{CF 1095F. Find the cheapest city, build the n-1 star edges plus m offers, run Kruskal. Weights up to 2e12 so all sums are long long}{lstlisting.31.1.2}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.1.2}{\ignorespaces CF 1095F. Find the cheapest city, build the n-1 star edges plus m offers, run Kruskal. Weights up to 2e12 so all sums are long long}}{1812}{lstlisting.31.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {31.2}Prim's Algorithm and the Frontier View}{1813}{section.31.2}\protected@file@percent }
\newlabel{sec:c17-prim}{{31.2}{1813}{Prim's Algorithm and the Frontier View}{section.31.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {31.2.1}Growing one component from a frontier}{1814}{subsection.31.2.1}\protected@file@percent }
\newlabel{def:c17-frontier}{{31.2.1}{1814}{Frontier (cut) of a partial tree}{tcb@cnt@definition.31.2.1}{}}
\newlabel{thm:c17-prim}{{31.2.2}{1814}{Prim's algorithm}{tcb@cnt@definition.31.2.2}{}}
\newlabel{lem:c17-dijkstra}{{31.2.3}{1814}{Prim is not Dijkstra}{tcb@cnt@definition.31.2.3}{}}
\newlabel{lst:c17-prim}{{31.2.1}{1814}{Prim with a binary heap. Push (weight, to) neighbours of each newly added vertex; lazily skip stale entries whose endpoint is already in the tree. Costs O(m log n). Returns MST weight and edge count}{lstlisting.31.2.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.2.1}{\ignorespaces Prim with a binary heap. Push (weight, to) neighbours of each newly added vertex; lazily skip stale entries whose endpoint is already in the tree. Costs O(m log n). Returns MST weight and edge count}}{1814}{lstlisting.31.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {31.2.2}The dense-graph \(\ensuremath  {O(n^2)}\) variant}{1815}{subsection.31.2.2}\protected@file@percent }
\newlabel{lst:c17-prim-matrix}{{31.2.2}{1815}{Matrix Prim, O(n squared). The best array holds the cheapest tree-to-vertex edge weight; pick the minimum over outside vertices, then relax it with the newly added row. Ideal for dense graphs or an explicit weight matrix}{lstlisting.31.2.2}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.2.2}{\ignorespaces Matrix Prim, O(n squared). The best array holds the cheapest tree-to-vertex edge weight; pick the minimum over outside vertices, then relax it with the newly added row. Ideal for dense graphs or an explicit weight matrix}}{1815}{lstlisting.31.2.2}\protected@file@percent }
