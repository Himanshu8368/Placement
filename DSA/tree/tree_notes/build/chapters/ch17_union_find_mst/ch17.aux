\@writefile{lof}{\contentsline {figure}{\numberline {31.2.1}{\ignorespaces Prim's take order on \(G\). The badge on each edge is the step (1--4) that added it; edge \(1\!-\!3\) carries its weight \(3\) instead since it shares the round with vertex 3's insertion. The final tree equals Kruskal's.}}{1816}{figure.caption.314}\protected@file@percent }
\newlabel{fig:c17-prim-trace}{{31.2.1}{1816}{Prim's take order on \(G\). The badge on each edge is the step (1--4) that added it; edge \(1\!-\!3\) carries its weight \(3\) instead since it shares the round with vertex 3's insertion. The final tree equals Kruskal's}{figure.caption.314}{}}
\@writefile{toc}{\contentsline {section}{\numberline {31.3}The Kruskal-Reconstruction Tree}{1817}{section.31.3}\protected@file@percent }
\newlabel{sec:c17-krt}{{31.3}{1817}{The Kruskal-Reconstruction Tree}{section.31.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {31.3.1}Building the merge tree}{1817}{subsection.31.3.1}\protected@file@percent }
\newlabel{def:c17-krt}{{31.3.1}{1817}{Kruskal-reconstruction tree}{tcb@cnt@definition.31.3.1}{}}
\newlabel{lem:c17-krtheight}{{31.3.2}{1817}{Weights increase upward}{tcb@cnt@definition.31.3.2}{}}
\newlabel{thm:c17-krtmax}{{31.3.3}{1817}{Bottleneck equals LCA weight}{tcb@cnt@definition.31.3.3}{}}
\newlabel{lst:c17-krt}{{31.3.1}{1818}{Kruskal-reconstruction tree. On every successful union, allocate a new node weighted by the edge and adopt the two component representatives as its children. The up array doubles as the DSU and the KRT parent pointer (find walks it). Queries then reduce to LCA on the KRT (Ch.16)}{lstlisting.31.3.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.3.1}{\ignorespaces Kruskal-reconstruction tree. On every successful union, allocate a new node weighted by the edge and adopt the two component representatives as its children. The up array doubles as the DSU and the KRT parent pointer (find walks it). Queries then reduce to LCA on the KRT (Ch.16)}}{1818}{lstlisting.31.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {31.3.2}WORKED: the reconstruction tree of the running graph}{1818}{subsection.31.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31.3.1}{\ignorespaces The reconstruction tree of \(G\). Internal nodes \(6,7,8,9\) carry the union weights \(1,2,3,6\); leaves are the original vertices. Reading \(\lca  (2,5)=9\) (weight \(6\)), \(\lca  (1,4)=8\) (weight \(3\)), \(\lca  (3,4)=7\) (weight \(2\)) gives the three bottleneck values below.}}{1819}{figure.caption.315}\protected@file@percent }
\newlabel{fig:c17-krt}{{31.3.1}{1819}{The reconstruction tree of \(G\). Internal nodes \(6,7,8,9\) carry the union weights \(1,2,3,6\); leaves are the original vertices. Reading \(\lca (2,5)=9\) (weight \(6\)), \(\lca (1,4)=8\) (weight \(3\)), \(\lca (3,4)=7\) (weight \(2\)) gives the three bottleneck values below}{figure.caption.315}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {31.3.3}Solved: CF 1081D -- Maximum Distance (1800, L4)}{1819}{subsection.31.3.3}\protected@file@percent }
\newlabel{prob:c17-maxdist}{{31.3.1}{1819}{Solved: CF 1081D -- Maximum Distance (1800, L4)}{solvedprob.31.3.1}{}}
\@writefile{lop}{\contentsline {problem}{\numberline {W31.3.1}Maximum Distance~--~CF 1081D}{1819}{solvedprob.31.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31.3.2}{\ignorespaces The KRT of Sample 2's MST \(\{4\!-\!2{:}1,\ 2\!-\!3{:}2,\ 1\!-\!3{:}3\}\). Node \(8\) (weight \(3\)) is the highest node whose two child subtrees each hold a special vertex (\(1\) versus \(\{2,3\}\)), so every special vertex's farthest-special bottleneck distance equals \(3\). This is \(Theorem~\ref {thm:c17-krtmax}\) read at the topmost special-splitting node.}}{1820}{figure.caption.316}\protected@file@percent }
\newlabel{fig:c17-maxdist}{{31.3.2}{1820}{The KRT of Sample 2's MST \(\{4\!-\!2{:}1,\ 2\!-\!3{:}2,\ 1\!-\!3{:}3\}\). Node \(8\) (weight \(3\)) is the highest node whose two child subtrees each hold a special vertex (\(1\) versus \(\{2,3\}\)), so every special vertex's farthest-special bottleneck distance equals \(3\). This is \(\thmref {c17-krtmax}\) read at the topmost special-splitting node}{figure.caption.316}{}}
\newlabel{lst:c17-maxdist}{{31.3.2}{1821}{CF 1081D. Kruskal with a per-component special count; answer = the largest weight of a union joining two special-bearing components, printed k times. Self-loops and duplicate edges are skipped by the a==b test}{lstlisting.31.3.2}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.3.2}{\ignorespaces CF 1081D. Kruskal with a per-component special count; answer = the largest weight of a union joining two special-bearing components, printed k times. Self-loops and duplicate edges are skipped by the a==b test}}{1821}{lstlisting.31.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {31.4}Which Edges Can Be in an MST?}{1823}{section.31.4}\protected@file@percent }
\newlabel{sec:c17-classify}{{31.4}{1823}{Which Edges Can Be in an MST?}{section.31.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {31.4.1}The two properties and the trichotomy}{1824}{subsection.31.4.1}\protected@file@percent }
\newlabel{def:c17-forced}{{31.4.1}{1824}{Forced, optional, forbidden}{tcb@cnt@definition.31.4.1}{}}
\newlabel{thm:c17-intersect}{{31.4.2}{1824}{Intersection property}{tcb@cnt@definition.31.4.2}{}}
\newlabel{thm:c17-cycle}{{31.4.3}{1824}{Cycle property (global form)}{tcb@cnt@definition.31.4.3}{}}
\newlabel{lem:c17-group}{{31.4.4}{1824}{Equal-weight group excess}{tcb@cnt@definition.31.4.4}{}}
\newlabel{lst:c17-group}{{31.4.1}{1824}{Per-group Kruskal that returns the total optional-excess sum. Edges are pre-sorted; each maximal equal-weight block is scanned twice: once to count usable edges against the pre-group DSU, once to perform the merges}{lstlisting.31.4.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.4.1}{\ignorespaces Per-group Kruskal that returns the total optional-excess sum. Edges are pre-sorted; each maximal equal-weight block is scanned twice: once to count usable edges against the pre-group DSU, once to perform the merges}}{1824}{lstlisting.31.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {31.4.2}Solved: CF 1108F -- MST Unification (2100, L5)}{1825}{subsection.31.4.2}\protected@file@percent }
\newlabel{prob:c17-unify}{{31.4.1}{1825}{Solved: CF 1108F -- MST Unification (2100, L5)}{solvedprob.31.4.1}{}}
\@writefile{lop}{\contentsline {problem}{\numberline {W31.4.1}MST Unification~--~CF 1108F}{1825}{solvedprob.31.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31.4.1}{\ignorespaces Sample 4, the \(3\)-cycle \(1\!-\!2{:}1,\ 2\!-\!3{:}3,\ 1\!-\!3{:}3\). The MST must take the weight-\(1\) edge and exactly one weight-\(3\) edge; the two weight-\(3\) edges tie, so the MST is not unique. Bumping one of them to \(4\) (costs one increment) makes the \(1\!-\!3{:}3\) edge forced and the answer \(\mathbf  {1}\).}}{1825}{figure.caption.317}\protected@file@percent }
\newlabel{fig:c17-unify}{{31.4.1}{1825}{Sample 4, the \(3\)-cycle \(1\!-\!2{:}1,\ 2\!-\!3{:}3,\ 1\!-\!3{:}3\). The MST must take the weight-\(1\) edge and exactly one weight-\(3\) edge; the two weight-\(3\) edges tie, so the MST is not unique. Bumping one of them to \(4\) (costs one increment) makes the \(1\!-\!3{:}3\) edge forced and the answer \(\mathbf {1}\)}{figure.caption.317}{}}
\newlabel{lst:c17-unify}{{31.4.2}{1827}{CF 1108F. Sort by weight; per equal-weight block count usable (against the pre-block DSU) then merged (after unioning), and add the difference. Exactly the two-scan loop of optionalExcess}{lstlisting.31.4.2}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.4.2}{\ignorespaces CF 1108F. Sort by weight; per equal-weight block count usable (against the pre-block DSU) then merged (after unioning), and add the difference. Exactly the two-scan loop of optionalExcess}}{1827}{lstlisting.31.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31.4.2}{\ignorespaces Sample 6's weight-\(2\) group. The three lighter-components \(\{1\},\{2,3\},\{4\}\) need only \(2\) merges, but \(3\) edges offer to connect them -- the triangle. One edge is surplus (dashed) and must be lifted by \(1\).}}{1828}{figure.caption.318}\protected@file@percent }
\newlabel{fig:c17-groups}{{31.4.2}{1828}{Sample 6's weight-\(2\) group. The three lighter-components \(\{1\},\{2,3\},\{4\}\) need only \(2\) merges, but \(3\) edges offer to connect them -- the triangle. One edge is surplus (dashed) and must be lifted by \(1\)}{figure.caption.318}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {31.4.3}Solved: CF 160D -- Edges in MST (2300, L5)}{1829}{subsection.31.4.3}\protected@file@percent }
\newlabel{prob:c17-edges}{{31.4.2}{1829}{Solved: CF 160D -- Edges in MST (2300, L5)}{solvedprob.31.4.2}{}}
\@writefile{lop}{\contentsline {problem}{\numberline {W31.4.2}Edges in MST~--~CF 160D}{1829}{solvedprob.31.4.2}\protected@file@percent }
\newlabel{lem:c17-bridge}{{31.4.5}{1829}{Bridge \(\iff \) forced inside a group}{tcb@cnt@definition.31.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {31.4.3}{\ignorespaces Sample 1's weight-\(2\) group after contracting the lighter \(3\!-\!4{:}1\) edge: components \(\{1\},\{2\},\{3,4\}\). The only usable edges are \(2\!-\!3\) and \(2\!-\!4\), which are \emph  {parallel} in \(H\) (a \(2\)-cycle); a bridge must lie on no cycle, so neither is a bridge and both are \texttt  {at least one}. Vertex \(\{1\}\) has no weight-\(2\) edge, so it is isolated. Contrast the lone \(w{=}1\) edge \(3\!-\!4\) and the lone \(w{=}100\) edge \(1\!-\!3\), each a single bridge in its group and therefore \texttt  {any}.}}{1829}{figure.caption.319}\protected@file@percent }
\newlabel{fig:c17-edges}{{31.4.3}{1829}{Sample 1's weight-\(2\) group after contracting the lighter \(3\!-\!4{:}1\) edge: components \(\{1\},\{2\},\{3,4\}\). The only usable edges are \(2\!-\!3\) and \(2\!-\!4\), which are \emph {parallel} in \(H\) (a \(2\)-cycle); a bridge must lie on no cycle, so neither is a bridge and both are \texttt {at least one}. Vertex \(\{1\}\) has no weight-\(2\) edge, so it is isolated. Contrast the lone \(w{=}1\) edge \(3\!-\!4\) and the lone \(w{=}100\) edge \(1\!-\!3\), each a single bridge in its group and therefore \texttt {any}}{figure.caption.319}{}}
\newlabel{lst:c17-edges}{{31.4.3}{1831}{CF 160D. Per weight group: contract lighter edges, build the multigraph H of usable edges, Tarjan bridges (skip only the reverse edge-slot, so parallel edges are never false bridges). bridge->any, non-bridge usable->at least one, pre-merged->none. Union the whole block only after classifying}{lstlisting.31.4.3}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.4.3}{\ignorespaces CF 160D. Per weight group: contract lighter edges, build the multigraph H of usable edges, Tarjan bridges (skip only the reverse edge-slot, so parallel edges are never false bridges). bridge->any, non-bridge usable->at least one, pre-merged->none. Union the whole block only after classifying}}{1831}{lstlisting.31.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {31.5}The Method Boundary: Second-Best MST and Hand-Offs}{1833}{section.31.5}\protected@file@percent }
\newlabel{sec:c17-boundary}{{31.5}{1833}{The Method Boundary: Second-Best MST and Hand-Offs}{section.31.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {31.5.1}Second-best MST by a single replacement}{1834}{subsection.31.5.1}\protected@file@percent }
\newlabel{def:c17-replacement}{{31.5.1}{1834}{Replacement edge}{tcb@cnt@definition.31.5.1}{}}
\newlabel{thm:c17-second}{{31.5.2}{1834}{Second-best MST}{tcb@cnt@definition.31.5.2}{}}
\newlabel{lst:c17-second}{{31.5.1}{1834}{Second-best MST. Build T* and its maxEdge-on-path via the reconstruction tree / LCA (Ch.16), then for each non-tree edge add weight(T*) + w(e) - maxEdgeOnPath(u,v) and take the strict minimum. Naive path walk is O(mn); LCA makes it O(m log n)}{lstlisting.31.5.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.5.1}{\ignorespaces Second-best MST. Build T* and its maxEdge-on-path via the reconstruction tree / LCA (Ch.16), then for each non-tree edge add weight(T*) + w(e) - maxEdgeOnPath(u,v) and take the strict minimum. Naive path walk is O(mn); LCA makes it O(m log n)}}{1834}{lstlisting.31.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {31.5.2}WORKED: the second-best tree of the running graph}{1834}{subsection.31.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31.5.1}{\ignorespaces One optimal second-best swap. Adding the non-tree edge \(2\!-\!3{:}4\) closes the cycle \(2\!-\!1\!-\!3\); dropping the heaviest tree edge on it (\(1\!-\!3{:}3\)) yields a spanning tree of weight \(13\), tied by the \(3\!-\!5\) swap. This is \(Theorem~\ref {thm:c17-second}\) executed.}}{1835}{figure.caption.320}\protected@file@percent }
\newlabel{fig:c17-second}{{31.5.1}{1835}{One optimal second-best swap. Adding the non-tree edge \(2\!-\!3{:}4\) closes the cycle \(2\!-\!1\!-\!3\); dropping the heaviest tree edge on it (\(1\!-\!3{:}3\)) yields a spanning tree of weight \(13\), tied by the \(3\!-\!5\) swap. This is \(\thmref {c17-second}\) executed}{figure.caption.320}{}}
