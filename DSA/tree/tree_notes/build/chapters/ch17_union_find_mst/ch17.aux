\newlabel{prob:c17-summit}{{31.5.1}{1841}{}{solvedprob.31.5.1}{}}
\@writefile{lop}{\contentsline {problem}{\numberline {W31.5.1}Xor-MST~--~CF 888G}{1841}{solvedprob.31.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31.5.2}{\ignorespaces The disguise (sample 1): a complete graph whose edge weights are xors of the vertex values. Drawing it directly and sorting \(\binom  n2\) edges is hopeless; the reduction turns it into one recursion over bits.}}{1841}{figure.caption.321}\protected@file@percent }
\newlabel{fig:c17-summit-disguise}{{31.5.2}{1841}{The disguise (sample 1): a complete graph whose edge weights are xors of the vertex values. Drawing it directly and sorting \(\binom n2\) edges is hopeless; the reduction turns it into one recursion over bits}{figure.caption.321}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {31.5.3}{\ignorespaces The true structure after the reduction (sample 1, top bit \(2^2\)). Vertices split into \(L=\{1,2,3\}\) (bit~2 clear) and \(R=\{4,5\}\) (bit~2 set). The MST cost is the two halves' costs plus the single cheapest cross edge (\(1\oplus 5 = 4\)), which the cut property forces to exactly one edge.}}{1841}{figure.caption.322}\protected@file@percent }
\newlabel{fig:c17-summit-reduce}{{31.5.3}{1841}{The true structure after the reduction (sample 1, top bit \(2^2\)). Vertices split into \(L=\{1,2,3\}\) (bit~2 clear) and \(R=\{4,5\}\) (bit~2 set). The MST cost is the two halves' costs plus the single cheapest cross edge (\(1\oplus 5 = 4\)), which the cut property forces to exactly one edge}{figure.caption.322}{}}
\newlabel{lst:c17-summit}{{31.5.2}{1843}{CF 888G. Divide the value set on the highest bit; sum the two halves plus the minimum cross xor from a binary trie. Recursion is on bit depth (30), values move to exactly one child per level, so total work is O(30 n)}{lstlisting.31.5.2}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {31.5.2}{\ignorespaces CF 888G. Divide the value set on the highest bit; sum the two halves plus the minimum cross xor from a binary trie. Recursion is on bit depth (30), values move to exactly one child per level, so total work is O(30 n)}}{1843}{lstlisting.31.5.2}\protected@file@percent }
