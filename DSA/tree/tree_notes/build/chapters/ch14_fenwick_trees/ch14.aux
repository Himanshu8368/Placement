\@writefile{toc}{\contentsline {subsection}{\numberline {18.1.3}Why It Is a Hidden Binary Tree}{1087}{subsection.18.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18.1.1}{\ignorespaces The BIT over \([1..16]\) drawn as the forest its parent rule defines. Slot~16 roots the whole array (block \([1,16]\)); the children of any slot \(s\) are \(s-\operatorname  {lowbit}(s)/2\) and its recursive split, mirroring a segment tree \emph  {whose split points are the binary carries instead of the midpoints}. The \texttt  {query} walk is a root path in this forest read bottom-up with sibling sums skipped; \texttt  {update} is the same path top-down. This is why textbook proofs of \(\ensuremath  {O(\log n)}\) need no amortisation: the forest has height \(\lceil \log _2 n\rceil \).}}{1087}{figure.caption.190}\protected@file@percent }
\newlabel{fig:c14-hiddentree}{{18.1.1}{1087}{The BIT over \([1..16]\) drawn as the forest its parent rule defines. Slot~16 roots the whole array (block \([1,16]\)); the children of any slot \(s\) are \(s-\operatorname {lowbit}(s)/2\) and its recursive split, mirroring a segment tree \emph {whose split points are the binary carries instead of the midpoints}. The \code {query} walk is a root path in this forest read bottom-up with sibling sums skipped; \code {update} is the same path top-down. This is why textbook proofs of \(\bigO {\log n}\) need no amortisation: the forest has height \(\lceil \log _2 n\rceil \)}{figure.caption.190}{}}
