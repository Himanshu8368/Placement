\newlabel{ch:c23}{{25}{1518}{Link-Cut Trees (Dynamic Trees)}{chapter.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {25.0.1}{\ignorespaces The running forest \(R\) (\(n=8\), rooted at \(1\)). The orange solid edges \(1\!-\!2\!-\!5\!-\!7\) are the preferred path after an \texttt  {access(7)}; the orange nodes are one auxiliary splay tree keyed by depth. The white subtrees \(\{4\}\), \(\{6\}\), \(\{3,8\}\) are each their own preferred path (their own aux tree) whose top node's \emph  {path-parent} pointer aims up into the orange spine.}}{1520}{figure.caption.264}\protected@file@percent }
\newlabel{fig:c23-tree}{{25.0.1}{1520}{The running forest \(R\) (\(n=8\), rooted at \(1\)). The orange solid edges \(1\!-\!2\!-\!5\!-\!7\) are the preferred path after an \code {access(7)}; the orange nodes are one auxiliary splay tree keyed by depth. The white subtrees \(\{4\}\), \(\{6\}\), \(\{3,8\}\) are each their own preferred path (their own aux tree) whose top node's \emph {path-parent} pointer aims up into the orange spine}{figure.caption.264}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {25.0.2}{\ignorespaces The chapter's five-state taxonomy. \emph  {splay} is the engine; \emph  {access} turns the engine into a rooted dynamic-LCA structure; \emph  {evert} adds rerooting and so full link/cut/path-aggregate power; \emph  {virtual} is the extra accumulator a real LCT needs for subtree queries and the connectivity-vs-path split; \emph  {pick} is the boundary choosing between an LCT and its cheaper neighbours. Each solved problem sits on one row: ORDERSET on \emph  {splay}, DYNALCA on \emph  {access}, the worked path-sum on \emph  {evert}, the \texttt  {vsum} example on \emph  {virtual}, and the Summit CF~487E on \emph  {evert}+a block-cut condensation.}}{1521}{figure.caption.265}\protected@file@percent }
\newlabel{fig:c23-taxonomy}{{25.0.2}{1521}{The chapter's five-state taxonomy. \emph {splay} is the engine; \emph {access} turns the engine into a rooted dynamic-LCA structure; \emph {evert} adds rerooting and so full link/cut/path-aggregate power; \emph {virtual} is the extra accumulator a real LCT needs for subtree queries and the connectivity-vs-path split; \emph {pick} is the boundary choosing between an LCT and its cheaper neighbours. Each solved problem sits on one row: ORDERSET on \emph {splay}, DYNALCA on \emph {access}, the worked path-sum on \emph {evert}, the \code {vsum} example on \emph {virtual}, and the Summit CF~487E on \emph {evert}+a block-cut condensation}{figure.caption.265}{}}
\@writefile{toc}{\contentsline {section}{\numberline {25.1}The Splay Engine: Balance by Locality}{1523}{section.25.1}\protected@file@percent }
\newlabel{sec:c23-splay}{{25.1}{1523}{The Splay Engine: Balance by Locality}{section.25.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {25.1.1}Splaying, and why its average is logarithmic}{1524}{subsection.25.1.1}\protected@file@percent }
\newlabel{def:c23-splay}{{25.1.1}{1524}{Splaying a node to the root}{tcb@cnt@definition.25.1.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {25.1.1}{\ignorespaces The three splay cases around a grandparent \(g\), parent \(p\), target \(x\) (\(x\) in orange). \emph  {zig} ends the splay (no grandparent). \emph  {zig-zig} and \emph  {zig-zag} each lift \(x\) two levels; the choice -- same side versus opposite side -- is exactly what keeps the tree self-correcting and makes the amortised bound work (\(Theorem~\ref {thm:c23-splay-amort}\)). Names and mechanics are Ch.~8's (\(Figure~\ref {fig:c06-splayfig}\)); here they are only relabelled for reference.}}{1524}{figure.caption.266}\protected@file@percent }
\newlabel{fig:c23-splaycases}{{25.1.1}{1524}{The three splay cases around a grandparent \(g\), parent \(p\), target \(x\) (\(x\) in orange). \emph {zig} ends the splay (no grandparent). \emph {zig-zig} and \emph {zig-zag} each lift \(x\) two levels; the choice -- same side versus opposite side -- is exactly what keeps the tree self-correcting and makes the amortised bound work (\(\thmref {c23-splay-amort}\)). Names and mechanics are Ch.~8's (\(\figref {c06-splayfig}\)); here they are only relabelled for reference}{figure.caption.266}{}}
\newlabel{thm:c23-splay-amort}{{25.1.2}{1524}{Splaying is \(O(\log n)\) amortised per operation}{tcb@cnt@definition.25.1.2}{}}
\newlabel{lst:c23-splay-rot}{{25.1.1}{1525}{Bottom-up splay: rotate x up two levels at a time. grand(x) is x's grandparent; the zig-zig vs zig-zag split is the whole art. Assumes parent pointers. ASCII only}{lstlisting.25.1.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {25.1.1}{\ignorespaces Bottom-up splay: rotate x up two levels at a time. grand(x) is x's grandparent; the zig-zig vs zig-zag split is the whole art. Assumes parent pointers. ASCII only}}{1525}{lstlisting.25.1.1}\protected@file@percent }
\newlabel{lst:c23-topdown}{{25.1.2}{1525}{Top-down splaying: one downward pass, no recursion, no parent pointers. Keys smaller than the walked-down spine accumulate on tree L, larger on tree R; x is re-attached at the end as the new root. ASCII only}{lstlisting.25.1.2}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {25.1.2}{\ignorespaces Top-down splaying: one downward pass, no recursion, no parent pointers. Keys smaller than the walked-down spine accumulate on tree L, larger on tree R; x is re-attached at the end as the new root. ASCII only}}{1525}{lstlisting.25.1.2}\protected@file@percent }
