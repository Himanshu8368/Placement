\newlabel{def:c23-virtual}{{25.4.1}{1540}{Virtual children and the \(\mathit {vir}\) accumulator}{tcb@cnt@definition.25.4.1}{}}
\newlabel{thm:c23-vsum}{{25.4.2}{1540}{Access moves children between the solid and virtual sets}{tcb@cnt@definition.25.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {25.4.1}{\ignorespaces On the running forest \(R\) (\(Figure~\ref {fig:c23-tree}\)) after \texttt  {access(7)}, the solid path \(2\!-\!5\!-\!7\) (orange) lives in the aux splay; children \(4\) (of \(2\)) and \(6\) (of \(5\)) are \emph  {virtual} (dashed green) and are excluded from the path fold but included in \(\mathit  {vir}[2]\), \(\mathit  {vir}[5]\) so that a \emph  {subtree} query still counts them. When a later access demotes \(5\)'s solid child and promotes \(6\), the two \(\mathit  {sub}\) values trade between the splay and \(\mathit  {vir}[5]\) exactly as \(Theorem~\ref {thm:c23-vsum}\) prescribes.}}{1540}{figure.caption.268}\protected@file@percent }
\newlabel{fig:c23-virtual}{{25.4.1}{1540}{On the running forest \(R\) (\(\figref {c23-tree}\)) after \code {access(7)}, the solid path \(2\!-\!5\!-\!7\) (orange) lives in the aux splay; children \(4\) (of \(2\)) and \(6\) (of \(5\)) are \emph {virtual} (dashed green) and are excluded from the path fold but included in \(\mathit {vir}[2]\), \(\mathit {vir}[5]\) so that a \emph {subtree} query still counts them. When a later access demotes \(5\)'s solid child and promotes \(6\), the two \(\mathit {sub}\) values trade between the splay and \(\mathit {vir}[5]\) exactly as \(\thmref {c23-vsum}\) prescribes}{figure.caption.268}{}}
