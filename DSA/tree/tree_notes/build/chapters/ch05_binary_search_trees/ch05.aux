\@writefile{lof}{\contentsline {figure}{\numberline {7.0.1}{\ignorespaces The running BST $B$. Root $8$; every left subtree holds smaller keys, every right subtree larger keys. Nine keys, eight edges, height $3$ -- and one deletion away from being a chain. That fragility is the thread to Chapter~8.}}{413}{figure.caption.73}\protected@file@percent }
\newlabel{fig:c05-running}{{7.0.1}{413}{The running BST $B$. Root $8$; every left subtree holds smaller keys, every right subtree larger keys. Nine keys, eight edges, height $3$ -- and one deletion away from being a chain. That fragility is the thread to Chapter~8}{figure.caption.73}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.1}The BST Property and Searching}{416}{section.7.1}\protected@file@percent }
\newlabel{sec:c05-property}{{7.1}{416}{The BST Property and Searching}{section.7.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1.1}Intuition}{417}{subsection.7.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.1.1}{\ignorespaces Searching $B$ for $7$ follows one root-to-leaf path (thick edges): $8\to 3\to 6\to 7$, four comparisons, and it never inspects the five keys $1,4,10,13,14$. The descent is only sound because the invariant holds \emph  {recursively} -- every key under $8$'s left child is below $8$, not merely below $3$. That recursion is exactly what the naive validation gets wrong.}}{417}{figure.caption.75}\protected@file@percent }
\newlabel{fig:c05-search}{{7.1.1}{417}{Searching $B$ for $7$ follows one root-to-leaf path (thick edges): $8\to 3\to 6\to 7$, four comparisons, and it never inspects the five keys $1,4,10,13,14$. The descent is only sound because the invariant holds \emph {recursively} -- every key under $8$'s left child is below $8$, not merely below $3$. That recursion is exactly what the naive validation gets wrong}{figure.caption.75}{}}
