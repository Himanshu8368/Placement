\@writefile{lof}{\contentsline {figure}{\numberline {7.4.1}{\ignorespaces Tracked intervals as an ordered \texttt  {map} start$\to $end. Querying $[14,28)$ touches at most one interval starting before $14$ (found by \texttt  {upper\_bound(14)} then step-back, giving \texttt  {10->20}) plus the run of intervals starting inside $[14,28)$ (\texttt  {25->30}). Coverage and unions are decided on these $\ensuremath  {O(\log n + k)}$ locals -- the map never scans all intervals.}}{447}{figure.caption.79}\protected@file@percent }
\newlabel{fig:c05-interval}{{7.4.1}{447}{Tracked intervals as an ordered \code {map} start$\to $end. Querying $[14,28)$ touches at most one interval starting before $14$ (found by \code {upper\_bound(14)} then step-back, giving \code {10->20}) plus the run of intervals starting inside $[14,28)$ (\code {25->30}). Coverage and unions are decided on these $\bigO {\log n + k}$ locals -- the map never scans all intervals}{figure.caption.79}{}}
