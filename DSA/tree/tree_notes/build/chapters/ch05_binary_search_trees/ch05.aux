\@writefile{lof}{\contentsline {figure}{\numberline {7.1.2}{\ignorespaces The local-check trap. Every node is correctly ordered against \emph  {its own children}, yet the tree is \textbf  {not} a BST: node $1$ lies in the right subtree of $5$ (so must exceed $5$) but equals $1$. Only the inherited-bound test of Theorem~\ref {thm:c05-bounds} -- giving node $1$ the interval $(5,7)$ -- flags it. W\ref {prob:c05-search} uses this same $B$ for search; Theorem~\ref {thm:c05-bounds} is the reason validation is a \emph  {descent}, not a per-node comparison.}}{419}{figure.caption.76}\protected@file@percent }
\newlabel{fig:c05-trap}{{7.1.2}{419}{The local-check trap. Every node is correctly ordered against \emph {its own children}, yet the tree is \textbf {not} a BST: node $1$ lies in the right subtree of $5$ (so must exceed $5$) but equals $1$. Only the inherited-bound test of \thmref {c05-bounds} -- giving node $1$ the interval $(5,7)$ -- flags it. \probref {c05-search} uses this same $B$ for search; \thmref {c05-bounds} is the reason validation is a \emph {descent}, not a per-node comparison}{figure.caption.76}{}}
