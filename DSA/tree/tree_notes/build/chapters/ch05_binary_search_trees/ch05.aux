\newlabel{sec:c05-insert-delete}{{7.2}{426}{Insertion and Deletion}{section.7.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2.1}Intuition}{427}{subsection.7.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.2.1}{\ignorespaces The two-child deletion. Node $v$ (red) has two subtrees $L,R$; we cannot drop or bypass it. Instead we take $s$ -- the inorder successor, the left-most node of $R$ (green) -- copy $s$'s key into $v$, and delete the \emph  {original} $s$. Because $s$ was left-most it has no left child, so deleting $s$ is the trivial leaf/one-child case. Every key stays on its correct side: $s>v$ and every $L$ key $<s$, so the sorted line is preserved (Proposition~\ref {prop:c05-preserve}).}}{427}{figure.caption.77}\protected@file@percent }
\newlabel{fig:c05-del2}{{7.2.1}{427}{The two-child deletion. Node $v$ (red) has two subtrees $L,R$; we cannot drop or bypass it. Instead we take $s$ -- the inorder successor, the left-most node of $R$ (green) -- copy $s$'s key into $v$, and delete the \emph {original} $s$. Because $s$ was left-most it has no left child, so deleting $s$ is the trivial leaf/one-child case. Every key stays on its correct side: $s>v$ and every $L$ key $<s$, so the sorted line is preserved (\propref {c05-preserve})}{figure.caption.77}{}}
