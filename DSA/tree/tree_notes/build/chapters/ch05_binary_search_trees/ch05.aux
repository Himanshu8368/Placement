\@writefile{lof}{\contentsline {figure}{\numberline {7.3.1}{\ignorespaces The sorted line of $B$. Order statistics live here: the $k$th smallest is index $k$, the minimum absolute difference is the smallest gap of \emph  {neighbours} (green), the successor of $6$ is $7$. Streaming inorder visits cells left-to-right, so we read each answer off with one variable of history and can halt early -- no array, no sort.}}{437}{figure.caption.78}\protected@file@percent }
\newlabel{fig:c05-line}{{7.3.1}{437}{The sorted line of $B$. Order statistics live here: the $k$th smallest is index $k$, the minimum absolute difference is the smallest gap of \emph {neighbours} (green), the successor of $6$ is $7$. Streaming inorder visits cells left-to-right, so we read each answer off with one variable of history and can halt early -- no array, no sort}{figure.caption.78}{}}
