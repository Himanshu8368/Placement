\newlabel{thm:c27-exchange}{{14.3.2}{862}{The deepest-uncovered greedy is optimal for the distance-$R$ cover}{tcb@cnt@definition.14.3.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {14.3.3}The Algorithm: Deepest-Uncovered Sweep}{863}{subsection.14.3.3}\protected@file@percent }
\newlabel{lst:c27-greedy}{{14.3.1}{863}{The CF 1029E greedy: root at 1, sweep vertices by decreasing depth, attach 1 to the parent of each still-uncovered vertex}{lstlisting.14.3.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {14.3.1}{\ignorespaces The CF 1029E greedy: root at 1, sweep vertices by decreasing depth, attach 1 to the parent of each still-uncovered vertex}}{863}{lstlisting.14.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {14.3.4}Worked Example: The Two-Edge Cover of $T$}{864}{subsection.14.3.4}\protected@file@percent }
\newlabel{ex:c27-greedy-run}{{14.3.3}{864}{Running CF~1029E's greedy on the running tree $T$}{tcb@cnt@definition.14.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14.3.1}{\ignorespaces The greedy cover of $T$. Deepest uncovered node $10$ (depth~$4$) forces the edge $(1,\parent  (10)) = (1,9)$, covering $\{9,7,10\}$ within distance~$2$ of~$1$; then the deepest still-uncovered node $8$ (depth~$3$) forces $(1,\parent  (8)) = (1,5)$, covering $\{5,2,8\}$. Every vertex is now within distance~$2$ of~$1$, and Theorem~\ref {thm:c27-exchange} guarantees no single-edge alternative does it (one edge can cover at most a closed neighbourhood, which never spans both the $8$- and $10$-branches). Answer $=2$.}}{864}{figure.caption.147}\protected@file@percent }
\newlabel{fig:c27-greedyfig}{{14.3.1}{864}{The greedy cover of $T$. Deepest uncovered node $10$ (depth~$4$) forces the edge $(1,\parent (10)) = (1,9)$, covering $\{9,7,10\}$ within distance~$2$ of~$1$; then the deepest still-uncovered node $8$ (depth~$3$) forces $(1,\parent (8)) = (1,5)$, covering $\{5,2,8\}$. Every vertex is now within distance~$2$ of~$1$, and \thmref {c27-exchange} guarantees no single-edge alternative does it (one edge can cover at most a closed neighbourhood, which never spans both the $8$- and $10$-branches). Answer $=2$}{figure.caption.147}{}}
