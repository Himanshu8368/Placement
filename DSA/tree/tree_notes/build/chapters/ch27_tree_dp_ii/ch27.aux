\newlabel{thm:c27-grundy-xor}{{14.4.2}{871}{Disjoint sums combine by XOR (Sprague-Grundy)}{tcb@cnt@definition.14.4.2}{}}
\newlabel{thm:c27-hackenbush}{{14.4.3}{872}{Green Hackenbush on a rooted tree: $g(v) = \bigoplus _c (g(c) + 1)$}{tcb@cnt@definition.14.4.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {14.4.3}The Algorithm: Grundy Fold by Post-Order DFS}{872}{subsection.14.4.3}\protected@file@percent }
\newlabel{lst:c27-grundy}{{14.4.1}{872}{Generic Grundy fold (mex over children) and the Hackenbush shortcut (xor of child+1); both are one post-order pass, same skeleton as \coderef {c27-knap}}{lstlisting.14.4.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {14.4.1}{\ignorespaces Generic Grundy fold (mex over children) and the Hackenbush shortcut (xor of child+1); both are one post-order pass, same skeleton as Code~\ref {lst:c27-knap}}}{872}{lstlisting.14.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {14.4.4}Worked Example: Grundy Overlay on the Running Tree $T$}{873}{subsection.14.4.4}\protected@file@percent }
\newlabel{ex:c27-grundy-run}{{14.4.4}{873}{The cutting-game value of the running tree $T$ rooted at $1$}{tcb@cnt@definition.14.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14.4.1}{\ignorespaces The Hackenbush Grundy overlay of $T$, rooted at $1$. Leaves $4,6,8,10$ have $g=0$; then $g(9)=g(10){+}1=1$, $g(5)=1$, $g(7)=g(9){+}1=2$; $g(2)=(0{+}1)\oplus (1{+}1)=1\oplus 2=3$ and $g(3)=(0{+}1)\oplus (2{+}1)=1\oplus 3=2$; finally $g(1)=(3{+}1)\oplus (2{+}1)=4\oplus 3=7$. Every XOR re-checks by hand, so the first cutter wins and can move the root to a $0$-value position.}}{873}{figure.caption.149}\protected@file@percent }
\newlabel{fig:c27-gamefig}{{14.4.1}{873}{The Hackenbush Grundy overlay of $T$, rooted at $1$. Leaves $4,6,8,10$ have $g=0$; then $g(9)=g(10){+}1=1$, $g(5)=1$, $g(7)=g(9){+}1=2$; $g(2)=(0{+}1)\oplus (1{+}1)=1\oplus 2=3$ and $g(3)=(0{+}1)\oplus (2{+}1)=1\oplus 3=2$; finally $g(1)=(3{+}1)\oplus (2{+}1)=4\oplus 3=7$. Every XOR re-checks by hand, so the first cutter wins and can move the root to a $0$-value position}{figure.caption.149}{}}
