\newlabel{lst:c27-profile}{{14.2.1}{853}{A single rollback patience profile maintained through a DFS: extend on entry, undo the exact change on exit}{lstlisting.14.2.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {14.2.1}{\ignorespaces A single rollback patience profile maintained through a DFS: extend on entry, undo the exact change on exit}}{853}{lstlisting.14.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {14.2.4}Worked Example: A Growing Profile on $T$}{854}{subsection.14.2.4}\protected@file@percent }
\newlabel{ex:c27-profile-run}{{14.2.3}{854}{The longest increasing path-profile on the running tree $T$}{tcb@cnt@definition.14.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14.2.1}{\ignorespaces The \emph  {growing} patience profile along the increasing path $8\!\to \!10$ of $T$ (values $8,5,2,1,3,7,9,10$), rooted at $8$. The red badge at each path node is the length of the tails array after that node is fed to Code~\ref {lst:c27-profile}: it drops to $1$ as the head values $8,5,2,1$ each replace slot~$0$, then climbs $2,3,4,5$ as $3,7,9,10$ extend it. Final length $5$ -- the LIS of the path, and the profile maximum over all of $T$. Unlike 14.1's fixed $V$, this index \emph  {grew} with the chain.}}{855}{figure.caption.145}\protected@file@percent }
\newlabel{fig:c27-profilefig}{{14.2.1}{855}{The \emph {growing} patience profile along the increasing path $8\!\to \!10$ of $T$ (values $8,5,2,1,3,7,9,10$), rooted at $8$. The red badge at each path node is the length of the tails array after that node is fed to \coderef {c27-profile}: it drops to $1$ as the head values $8,5,2,1$ each replace slot~$0$, then climbs $2,3,4,5$ as $3,7,9,10$ extend it. Final length $5$ -- the LIS of the path, and the profile maximum over all of $T$. Unlike 14.1's fixed $V$, this index \emph {grew} with the chain}{figure.caption.145}{}}
