\@writefile{lof}{\contentsline {figure}{\numberline {30.0.1}{\ignorespaces Chapter~30 on the six-step ladder: hand-encoding the Pr\"ufer code of the running tree is \(\textcolor {lv3}{\textbf  {L3}}\); the coded decode, the Laplacian determinant, and CF 280C's depth-reciprocal sum are \(\textcolor {lv4}{\textbf  {L4}}\); CF 2190D's per-vertex completion count is \(\textcolor {lv5}{\textbf  {L5}}\); the Summit (CF 917D) is step~6.}}{1763}{figure.caption.298}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {30.0.2}{\ignorespaces The running tree \(T\). Its Pr\"ufer code is \([5,5,3,4]\), and \(\DOTSB \sum@ \slimits@ _v 1/\mathrm  {depth}(v)\) from the root \(1\) is \(1/1+1/2+1/3+1/3+1/4+1/5 = 157/60\) (used in \(\S  \ref {sec:c32-expect}\)). This object is fixed for the whole chapter.}}{1764}{figure.caption.299}\protected@file@percent }
\newlabel{fig:c32-tree}{{30.0.2}{1764}{The running tree \(T\). Its Pr\"ufer code is \([5,5,3,4]\), and \(\sum _v 1/\mathrm {depth}(v)\) from the root \(1\) is \(1/1+1/2+1/3+1/3+1/4+1/5 = 157/60\) (used in \(\secref {c32-expect}\)). This object is fixed for the whole chapter}{figure.caption.299}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {30.0.3}{\ignorespaces The Pr\"ufer code \([5,5,3,4]\) laid out. The number of times a label appears in the code is exactly \(\deg -1\); every counting application in this chapter is a way of exploiting that one fact.}}{1764}{figure.caption.300}\protected@file@percent }
\newlabel{fig:c32-code}{{30.0.3}{1764}{The Pr\"ufer code \([5,5,3,4]\) laid out. The number of times a label appears in the code is exactly \(\deg -1\); every counting application in this chapter is a way of exploiting that one fact}{figure.caption.300}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {30.0.4}{\ignorespaces Where the four methods sit. A \emph  {labelled} enumeration on \([n]\) is either a Pr\"ufer-code argument (\(\S  \ref {sec:c32-prufer}\)) or a Cayley variant (\(\S  \ref {sec:c32-cayley}\)). Counting inside a \emph  {given graph} is either Matrix-Tree (\(\S  \ref {sec:c32-matrix}\)) or, if the answer is probabilistic, a linearity-of-expectation argument (\(\S  \ref {sec:c32-expect}\)).}}{1765}{figure.caption.301}\protected@file@percent }
\newlabel{fig:c32-taxonomy}{{30.0.4}{1765}{Where the four methods sit. A \emph {labelled} enumeration on \([n]\) is either a Pr\"ufer-code argument (\(\secref {c32-prufer}\)) or a Cayley variant (\(\secref {c32-cayley}\)). Counting inside a \emph {given graph} is either Matrix-Tree (\(\secref {c32-matrix}\)) or, if the answer is probabilistic, a linearity-of-expectation argument (\(\secref {c32-expect}\))}{figure.caption.301}{}}
