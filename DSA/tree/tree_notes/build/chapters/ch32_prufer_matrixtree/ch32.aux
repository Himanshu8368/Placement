\newlabel{lst:c32-encode}{{30.1.1}{1768}{Pruefer encode. Maintain a min-heap of current leaves and a degree array; pop the smallest leaf, write its live neighbour, decrement that neighbour, and push it if it becomes a leaf. ASCII only, identifiers without underscores}{lstlisting.30.1.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {30.1.1}{\ignorespaces Pruefer encode. Maintain a min-heap of current leaves and a degree array; pop the smallest leaf, write its live neighbour, decrement that neighbour, and push it if it becomes a leaf. ASCII only, identifiers without underscores}}{1768}{lstlisting.30.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {30.1.1}{\ignorespaces Mid-encode state after steps 1--2: leaves \(1,2\) dropped, code so far \([5,5]\), remaining tree is the path \(5\!-\!3\!-\!4\!-\!6\). Steps 3--4 drop \(5\) (write \(3\)) then \(3\) (write \(4\)).}}{1769}{figure.caption.302}\protected@file@percent }
\newlabel{fig:c32-encode}{{30.1.1}{1769}{Mid-encode state after steps 1--2: leaves \(1,2\) dropped, code so far \([5,5]\), remaining tree is the path \(5\!-\!3\!-\!4\!-\!6\). Steps 3--4 drop \(5\) (write \(3\)) then \(3\) (write \(4\))}{figure.caption.302}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {30.1.2}Decoding a Pr\"ufer code back to its tree}{1769}{subsection.30.1.2}\protected@file@percent }
\newlabel{lst:c32-decode}{{30.1.2}{1769}{Pruefer decode. Precompute count of each label in the code; use a min-heap of zero-count vertices as the candidate leaves; at each step emit edge smallest-leaf to code at t, decrement count of code at t, and push code at t into the heap if it just hit zero. After n-2 steps, two labels remain, emit their edge. ASCII only, identifiers without underscores}{lstlisting.30.1.2}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {30.1.2}{\ignorespaces Pruefer decode. Precompute count of each label in the code; use a min-heap of zero-count vertices as the candidate leaves; at each step emit edge smallest-leaf to code at t, decrement count of code at t, and push code at t into the heap if it just hit zero. After n-2 steps, two labels remain, emit their edge. ASCII only, identifiers without underscores}}{1769}{lstlisting.30.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {30.1.2}{\ignorespaces Decode of \([5,5,3,4]\): the four code entries generate four edges one-for-one (\(1\!-\!5, 2\!-\!5, 5\!-\!3, 3\!-\!4\)); the final residual pair \(\{4,6\}\) supplies the fifth edge \(4\!-\!6\).}}{1770}{figure.caption.303}\protected@file@percent }
\newlabel{fig:c32-decode}{{30.1.2}{1770}{Decode of \([5,5,3,4]\): the four code entries generate four edges one-for-one (\(1\!-\!5, 2\!-\!5, 5\!-\!3, 3\!-\!4\)); the final residual pair \(\{4,6\}\) supplies the fifth edge \(4\!-\!6\)}{figure.caption.303}{}}
