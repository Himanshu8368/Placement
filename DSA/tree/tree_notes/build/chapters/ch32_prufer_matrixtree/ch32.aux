\newlabel{lem:c32-deg}{{30.1.3}{1767}{Degree from multiplicity}{tcb@cnt@definition.30.1.3}{}}
\newlabel{thm:c32-bij}{{30.1.4}{1768}{Pr\"ufer's bijection}{tcb@cnt@definition.30.1.4}{}}
