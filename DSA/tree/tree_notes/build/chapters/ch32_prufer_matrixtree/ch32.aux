\@writefile{lol}{\contentsline {lstlisting}{\numberline {30.3.1}{\ignorespaces Build the Laplacian of a graph on n vertices with m edges, then delete row and column 0 (equivalent to any other by the theorem). Modular Gaussian elimination evaluates the determinant. ASCII only, identifiers without underscores}}{1780}{lstlisting.30.3.1}\protected@file@percent }
\newlabel{lst:c32-moddet}{{30.3.2}{1780}{Standalone modular determinant of an \(s\times s\) matrix under a prime \(p\), used repeatedly when the same Laplacian is queried for different minors. Gaussian elimination with row swap and multiplicative pivots; \(\bigO {s^3}\)}{lstlisting.30.3.2}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {30.3.2}{\ignorespaces Standalone modular determinant of an \(s\times s\) matrix under a prime \(p\), used repeatedly when the same Laplacian is queried for different minors. Gaussian elimination with row swap and multiplicative pivots; \(\ensuremath  {O(s^3)}\)}}{1780}{lstlisting.30.3.2}\protected@file@percent }
