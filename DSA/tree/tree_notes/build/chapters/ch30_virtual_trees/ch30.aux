\newlabel{ch:c30}{{26}{1565}{Virtual Trees (Auxiliary Trees)}{chapter.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {26.0.1}{\ignorespaces Chapter~26 on the six-step ladder: hand-building a virtual tree and reading its size is \(\textcolor {lv3}{\textbf  {L3}}\); the coded monotone-stack build and the \(O(k\log k)\) bound are \(\textcolor {lv4}{\textbf  {L4}}\); a DP that charges compressed-edge lengths and swallowed-node counts (or the pairwise-distance fold) is \(\textcolor {lv5}{\textbf  {L5}}\); the Summit (a virtual tree over factorial nodes solved by a weighted centroid) is step~6.}}{1566}{figure.caption.270}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {26.0.2}{\ignorespaces The running example. Left: the fixed tree \(T\); red nodes are the marked set \(S=\{4,8,6,10\}\), green nodes are the LCAs the construction must add (\(\{1,2,3\}\)), grey dashed nodes \(\{5,7,9\}\) are \emph  {swallowed}. Right: the virtual tree \(A(S)\) -- every real edge between two kept nodes is replaced by a \textbf  {\textcolor {deepblue}{compressed edge}} (thick) carrying the number of real edges it swallowed (\(2\!\to \!8\) has length \(2\) along \(2\text  {-}5\text  {-}8\)). The distance and ancestor relation between any two red/green nodes is exactly the real tree's.}}{1567}{figure.caption.271}\protected@file@percent }
\newlabel{fig:c30-tree}{{26.0.2}{1567}{The running example. Left: the fixed tree \(T\); red nodes are the marked set \(S=\{4,8,6,10\}\), green nodes are the LCAs the construction must add (\(\{1,2,3\}\)), grey dashed nodes \(\{5,7,9\}\) are \emph {swallowed}. Right: the virtual tree \(A(S)\) -- every real edge between two kept nodes is replaced by a \term {compressed edge} (thick) carrying the number of real edges it swallowed (\(2\!\to \!8\) has length \(2\) along \(2\text {-}5\text {-}8\)). The distance and ancestor relation between any two red/green nodes is exactly the real tree's}{figure.caption.271}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {26.0.3}{\ignorespaces The chapter's five-state taxonomy. \emph  {close} turns the marked set into an LCA-closed set; \emph  {link} builds the compressed tree with a stack; \emph  {fold} runs a weighted DP on it; \emph  {recognise} spots the signature in a statement; \emph  {reject} hands the job to the right neighbour. Each solved problem sits on one row: CF 2127E on \emph  {close}+a count, CF 2252F on \emph  {fold}, the Summit CF 1292D on \emph  {link}+a weighted centroid.}}{1568}{figure.caption.272}\protected@file@percent }
\newlabel{fig:c30-taxonomy}{{26.0.3}{1568}{The chapter's five-state taxonomy. \emph {close} turns the marked set into an LCA-closed set; \emph {link} builds the compressed tree with a stack; \emph {fold} runs a weighted DP on it; \emph {recognise} spots the signature in a statement; \emph {reject} hands the job to the right neighbour. Each solved problem sits on one row: CF 2127E on \emph {close}+a count, CF 2252F on \emph {fold}, the Summit CF 1292D on \emph {link}+a weighted centroid}{figure.caption.272}{}}
