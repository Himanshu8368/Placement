\@writefile{lof}{\contentsline {figure}{\numberline {5.4.1}{\ignorespaces The Euler tour of $G$ drawn as its depth profile (numbers under the dots are node ids; the vertical position is $\depth  $). Between the first appearances of $4$ and $6$ (dashed) the walk dips up to node $0$ -- the unique \emph  {minimum depth} in that window -- which is $\lca  (4,6)$. Distance is then $\depth  (4)+\depth  (6)-2\depth  (0)$.}}{328}{figure.caption.61}\protected@file@percent }
\newlabel{fig:c24-tour}{{5.4.1}{328}{The Euler tour of $G$ drawn as its depth profile (numbers under the dots are node ids; the vertical position is $\depth $). Between the first appearances of $4$ and $6$ (dashed) the walk dips up to node $0$ -- the unique \emph {minimum depth} in that window -- which is $\lca (4,6)$. Distance is then $\depth (4)+\depth (6)-2\depth (0)$}{figure.caption.61}{}}
