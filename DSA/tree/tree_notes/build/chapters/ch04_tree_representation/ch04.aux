\@writefile{lof}{\contentsline {figure}{\numberline {4.3.1}{\ignorespaces One binary tree, five encodings. The \# in the level-order array marks \emph  {skipped} positions so later children line up; the \# in the preorder marks \emph  {null children} so the stream is self-delimiting (Theorem~\ref {thm:c04-selfdelim}); $6$ sits under $3$'s \emph  {right} child, which the LC 606 brackets record explicitly as \texttt  {(3()(6))} but the dashed preorder cannot (see W\ref {prob:c04-recover-preorder}).}}{269}{figure.caption.53}\protected@file@percent }
\newlabel{fig:c04-encodings}{{4.3.1}{269}{One binary tree, five encodings. The \# in the level-order array marks \emph {skipped} positions so later children line up; the \# in the preorder marks \emph {null children} so the stream is self-delimiting (\thmref {c04-selfdelim}); $6$ sits under $3$'s \emph {right} child, which the LC 606 brackets record explicitly as \code {(3()(6))} but the dashed preorder cannot (see \probref {c04-recover-preorder})}{figure.caption.53}{}}
