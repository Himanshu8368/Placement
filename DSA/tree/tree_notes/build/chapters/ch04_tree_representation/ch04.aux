\@writefile{lof}{\contentsline {figure}{\numberline {4.0.1}{\ignorespaces Running example $R$ (binary). As pointers: each \texttt  {TreeNode} holds \texttt  {left},\ \texttt  {right}. If we instead \emph  {number nodes by their array slot} (root $=0$, left $=2i{+}1$, right $=2i{+}2$), the values land at slots $1\!\to \!0,\ 2\!\to \!1,\ 3\!\to \!2,\ 4\!\to \!3,\ 5\!\to \!4,\ 6\!\to \!5$ \emph  {only} when the tree is complete; here node $3$'s missing left child makes slot~3 a \emph  {hole} -- the exact reason implicit indexing needs a complete tree.}}{232}{figure.caption.48}\protected@file@percent }
\newlabel{fig:c04-running-r}{{4.0.1}{232}{Running example $R$ (binary). As pointers: each \code {TreeNode} holds \code {left},\ \code {right}. If we instead \emph {number nodes by their array slot} (root $=0$, left $=2i{+}1$, right $=2i{+}2$), the values land at slots $1\!\to \!0,\ 2\!\to \!1,\ 3\!\to \!2,\ 4\!\to \!3,\ 5\!\to \!4,\ 6\!\to \!5$ \emph {only} when the tree is complete; here node $3$'s missing left child makes slot~3 a \emph {hole} -- the exact reason implicit indexing needs a complete tree}{figure.caption.48}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.0.2}{\ignorespaces Running example $G$ (general tree, $7$ nodes, rooted at $0$). Its three representations, all describing the \emph  {same} object, appear in \S  \ref {sec:c04-reps} and \S  \ref {sec:c04-rooting}: adjacency \texttt  {adj} $=\{\{1,2,3\},\{0,4,5\},\{0\},\{0,6\},\{1\},\{1\},\{3\}\}$; parent array $\parent  =[-1,0,0,0,1,1,3]$; subtree sizes $\size  =[7,3,1,2,1,1,1]$. The bracket encoding of this rooting, $0(1(4)(5))(2)(3(6))$, is where \S  \ref {sec:c04-formats} begins.}}{232}{figure.caption.49}\protected@file@percent }
\newlabel{fig:c04-running-g}{{4.0.2}{232}{Running example $G$ (general tree, $7$ nodes, rooted at $0$). Its three representations, all describing the \emph {same} object, appear in \secref {c04-reps} and \secref {c04-rooting}: adjacency \code {adj} $=\{\{1,2,3\},\{0,4,5\},\{0\},\{0,6\},\{1\},\{1\},\{3\}\}$; parent array $\parent =[-1,0,0,0,1,1,3]$; subtree sizes $\size =[7,3,1,2,1,1,1]$. The bracket encoding of this rooting, $0(1(4)(5))(2)(3(6))$, is where \secref {c04-formats} begins}{figure.caption.49}{}}
