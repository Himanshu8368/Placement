\@writefile{lof}{\contentsline {figure}{\numberline {4.2.1}{\ignorespaces Rooting \emph  {is} orientation. The same six edges, poured from node $0$ by a parent-guarded DFS, become six parent$\to $child arrows, and the arrays $\parent  $, $\depth  $ (top-down) and $\size  $ (bottom-up) fall out of one traversal. Pick a different root and all three change.}}{251}{figure.caption.52}\protected@file@percent }
\newlabel{fig:c04-orient}{{4.2.1}{251}{Rooting \emph {is} orientation. The same six edges, poured from node $0$ by a parent-guarded DFS, become six parent$\to $child arrows, and the arrays $\parent $, $\depth $ (top-down) and $\size $ (bottom-up) fall out of one traversal. Pick a different root and all three change}{figure.caption.52}{}}
