\@writefile{lof}{\contentsline {figure}{\numberline {27.0.1}{\ignorespaces Chapter~27 on the six-step ladder: hand-running the block order and counting moves is \(\textcolor {lv3}{\textbf  {L3}}\); the coded array-Mo and DFS-stack-root-path solves (617E, 463E) are \(\textcolor {lv4}{\textbf  {L4}}\); the doubled-tour toggle for paths and Tarjan's offline LCA are \(\textcolor {lv5}{\textbf  {L5}}\); the Summit (an offline root-path frequency query) is step~6.}}{1609}{figure.caption.274}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {27.0.2}{\ignorespaces The running example \(R\) (8 nodes, root 1). Orange nodes are the subtree of \(2\), which the preorder flatten makes the single contiguous range \(P[\tin  (2){=}2\,..\,\tout  (2){=}5]\) (\(\S  \ref {sec:c21-subtree}\)). Red labels are \(\mathit  {val}(v)\), the colour whose ``distinct count on a range/path'' statistic has no inverse -- the whole reason this chapter exists.}}{1610}{figure.caption.275}\protected@file@percent }
\newlabel{fig:c21-tree}{{27.0.2}{1610}{The running example \(R\) (8 nodes, root 1). Orange nodes are the subtree of \(2\), which the preorder flatten makes the single contiguous range \(P[\tin (2){=}2\,..\,\tout (2){=}5]\) (\(\secref {c21-subtree}\)). Red labels are \(\mathit {val}(v)\), the colour whose ``distinct count on a range/path'' statistic has no inverse -- the whole reason this chapter exists}{figure.caption.275}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {27.0.3}{\ignorespaces The chapter's five-state taxonomy. \emph  {order} is the array Mo sweep; \emph  {flatten} lifts it to subtrees; \emph  {toggle} lifts it to paths via the doubled tour; \emph  {offline} is Tarjan's batched LCA; \emph  {reject} hands the job to the right neighbour. Each solved problem sits on one row: CF 617E on \emph  {order}, CF 463E riding the recursion stack beside \emph  {flatten}, the Summit CF 1585E on \emph  {toggle}+a frequency bucket.}}{1611}{figure.caption.276}\protected@file@percent }
\newlabel{fig:c21-taxonomy}{{27.0.3}{1611}{The chapter's five-state taxonomy. \emph {order} is the array Mo sweep; \emph {flatten} lifts it to subtrees; \emph {toggle} lifts it to paths via the doubled tour; \emph {offline} is Tarjan's batched LCA; \emph {reject} hands the job to the right neighbour. Each solved problem sits on one row: CF 617E on \emph {order}, CF 463E riding the recursion stack beside \emph {flatten}, the Summit CF 1585E on \emph {toggle}+a frequency bucket}{figure.caption.276}{}}
