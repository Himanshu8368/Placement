\@writefile{lof}{\contentsline {figure}{\numberline {12.1.1}{\ignorespaces Every node of $T$ after one DFS, tagged $\depth  {:}\height  {:}\size  $ in red below its number. Read the two currents: down a column the $\depth  $ values increase by $1$; up a column $\height  $ obeys $\max +1$ and $\size  $ obeys a sum, e.g.\ node~$5$ has $\height  {=}1$ from child~$8$, and node~$2$ has $\size  {=}1+1+2=4$. $\size  (1)=10=n$: the root's count checks the whole run.}}{719}{figure.caption.119}\protected@file@percent }
\newlabel{fig:c09-triples}{{12.1.1}{719}{Every node of $T$ after one DFS, tagged $\depth {:}\height {:}\size $ in red below its number. Read the two currents: down a column the $\depth $ values increase by $1$; up a column $\height $ obeys $\max +1$ and $\size $ obeys a sum, e.g.\ node~$5$ has $\height {=}1$ from child~$8$, and node~$2$ has $\size {=}1+1+2=4$. $\size (1)=10=n$: the root's count checks the whole run}{figure.caption.119}{}}
