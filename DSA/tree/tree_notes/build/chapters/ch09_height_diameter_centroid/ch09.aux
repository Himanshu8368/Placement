\@writefile{lof}{\contentsline {figure}{\numberline {12.2.1}{\ignorespaces The diametral path of $T$ in orange: $8\leftrightarrow 10$, $D=7$ edges. The off-path fringe (node~$4$ and node~$6$) hangs \emph  {from the middle} of the diameter --- which is the picture behind Lemma~\ref {lem:c09-sweepend}: starting the first sweep at the fringe node~$4$ still finds a true extremity ($10$), because a branch off the middle can never outrun the nearer diameter end. Node~$1$ is where the DP does the join.}}{729}{figure.caption.120}\protected@file@percent }
\newlabel{fig:c09-diampath}{{12.2.1}{729}{The diametral path of $T$ in orange: $8\leftrightarrow 10$, $D=7$ edges. The off-path fringe (node~$4$ and node~$6$) hangs \emph {from the middle} of the diameter --- which is the picture behind \lemref {c09-sweepend}: starting the first sweep at the fringe node~$4$ still finds a true extremity ($10$), because a branch off the middle can never outrun the nearer diameter end. Node~$1$ is where the DP does the join}{figure.caption.120}{}}
