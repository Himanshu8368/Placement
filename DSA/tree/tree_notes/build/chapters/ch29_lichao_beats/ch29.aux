\@writefile{lof}{\contentsline {figure}{\numberline {23.3.1}{\ignorespaces The three-way decision at one beats node for the state \((\max ,\mathrm  {smax},\mathrm  {cnt})=(5,3,2)\). Only the middle band (\(\mathrm  {smax}<x<\max \)) settles at the node with an \(O(1)\) patch; the low band is the only one that forces a recursion, and it is exactly the case that the amortised analysis must pay for.}}{1423}{figure.caption.255}\protected@file@percent }
\newlabel{fig:c29-beats}{{23.3.1}{1423}{The three-way decision at one beats node for the state \((\max ,\mathrm {smax},\mathrm {cnt})=(5,3,2)\). Only the middle band (\(\mathrm {smax}<x<\max \)) settles at the node with an \(O(1)\) patch; the low band is the only one that forces a recursion, and it is exactly the case that the amortised analysis must pay for}{figure.caption.255}{}}
