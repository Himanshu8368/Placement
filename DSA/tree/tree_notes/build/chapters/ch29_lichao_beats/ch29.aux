\@writefile{lof}{\contentsline {figure}{\numberline {23.4.1}{\ignorespaces The CF~750E automaton. State \(i\) is ``the longest prefix of \(\texttt  {2017}\) that is a subsequence of the kept digits'' has length \(i\). Reaching state~\(4\) means \(\texttt  {2017}\) is present. A kept digit matching the next pattern character advances the state (free); any other kept digit is inert -- \emph  {except} a \(\texttt  {6}\) at state \(\ge 3\), which would create the forbidden \(\texttt  {2016}\) subsequence and so must be deleted (cost~\(1\)). Each column of this diagram is one \(5\times 5\) min-plus matrix, and a query chains them.}}{1432}{figure.caption.256}\protected@file@percent }
\newlabel{fig:c29-func-auto}{{23.4.1}{1432}{The CF~750E automaton. State \(i\) is ``the longest prefix of \(\texttt {2017}\) that is a subsequence of the kept digits'' has length \(i\). Reaching state~\(4\) means \(\texttt {2017}\) is present. A kept digit matching the next pattern character advances the state (free); any other kept digit is inert -- \emph {except} a \(\texttt {6}\) at state \(\ge 3\), which would create the forbidden \(\texttt {2016}\) subsequence and so must be deleted (cost~\(1\)). Each column of this diagram is one \(5\times 5\) min-plus matrix, and a query chains them}{figure.caption.256}{}}
\newlabel{lst:c29-func}{{23.4.1}{1432}{Generic min-plus matrix and its composition (the merge operator of a function-composition tree). The identity is the (min,+) identity: 0 on the diagonal, infinity elsewhere. ASCII only}{lstlisting.23.4.1}{}}
