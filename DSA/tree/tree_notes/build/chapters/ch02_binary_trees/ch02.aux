\@writefile{lof}{\contentsline {figure}{\numberline {2.3.1}{\ignorespaces Subtree sums returned upward (green): leaves return their own value, node $2$ returns $2{+}4{+}5=11$, node $3$ returns $3{+}6=9$, the root returns $1{+}11{+}9=21$. The parent cannot be computed before the children -- the definition of bottom-up.}}{48}{figure.caption.25}\protected@file@percent }
