\@writefile{lof}{\contentsline {figure}{\numberline {9.0.1}{\ignorespaces The histogram running example $H=(2,1,5,6,2,3)$. Bars are drawn in index order; the monotonic stack (\S  \ref {sec:c26-monostack}) finds that the widest rectangle of height $5$ spans bars $3$--$4$ and has area $10$ -- the LeetCode~84 answer.}}{538}{figure.caption.92}\protected@file@percent }
\newlabel{fig:c26-hist}{{9.0.1}{538}{The histogram running example $H=(2,1,5,6,2,3)$. Bars are drawn in index order; the monotonic stack (\secref {c26-monostack}) finds that the widest rectangle of height $5$ spans bars $3$--$4$ and has area $10$ -- the LeetCode~84 answer}{figure.caption.92}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.0.2}{\ignorespaces The min-Cartesian tree of $A=(3,1,4,2)$. The root is the minimum ($1$, at position $2$); the left part ($a_1$) and right part ($a_3,a_4$) recurse. Its inorder is the array itself, and every parent is smaller than its children -- the two invariants of Definition~\ref {def:c26-cartesian}, shown on one object. Node $a_4$'s subtree is the single window $\{3,4\}$ where $2$ is the minimum: the span-equals-subtree idea of Lemma~\ref {lem:c26-span}.}}{538}{figure.caption.93}\protected@file@percent }
\newlabel{fig:c26-cartA}{{9.0.2}{538}{The min-Cartesian tree of $A=(3,1,4,2)$. The root is the minimum ($1$, at position $2$); the left part ($a_1$) and right part ($a_3,a_4$) recurse. Its inorder is the array itself, and every parent is smaller than its children -- the two invariants of \defref {c26-cartesian}, shown on one object. Node $a_4$'s subtree is the single window $\{3,4\}$ where $2$ is the minimum: the span-equals-subtree idea of \lemref {c26-span}}{figure.caption.93}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9.1}The Cartesian Tree in $O(n)$}{541}{section.9.1}\protected@file@percent }
\newlabel{sec:c26-cartesian}{{9.1}{541}{The Cartesian Tree in $O(n)$}{section.9.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.1.1}Intuition}{542}{subsection.9.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.1.1}{\ignorespaces The min-Cartesian tree of $A=(3,1,4,2)$, built by "root is the minimum, recurse on the two halves". Position subscripts are shown on the edges. The inorder traversal reads the array back ($3,1,4,2$); every parent is $\le $ its children. This is Definition~\ref {def:c26-cartesian}; Theorem~\ref {thm:c26-unique} says it is the \emph  {only} such tree, and Lemma~\ref {lem:c26-span} says each subtree is that node's dominance window.}}{542}{figure.caption.95}\protected@file@percent }
\newlabel{fig:c26-build}{{9.1.1}{542}{The min-Cartesian tree of $A=(3,1,4,2)$, built by "root is the minimum, recurse on the two halves". Position subscripts are shown on the edges. The inorder traversal reads the array back ($3,1,4,2$); every parent is $\le $ its children. This is \defref {c26-cartesian}; \thmref {c26-unique} says it is the \emph {only} such tree, and \lemref {c26-span} says each subtree is that node's dominance window}{figure.caption.95}{}}
