\newlabel{sec:c26-treapview}{{9.4}{568}{The Cartesian Tree as a Random Treap}{section.9.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.4.1}Intuition}{569}{subsection.9.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.4.1}{\ignorespaces One array $A=(3,1,4,2)$, three readings. (a) min-Cartesian tree -- inorder $=$ index, heap on value (Definition~\ref {def:c26-cartesian}). (b) the \emph  {identical} tree as a treap: keys are the indices $1..4$ (labels here), priorities are the values, root $=$ least-priority key $=2$ (Definition~\ref {def:c06-treap}); (a)$\equiv $(b) is Proposition~\ref {prop:c26-carters-treap}. (c) is the \emph  {other} assignment -- a plain BST built by inserting $3,1,4,2$, which is a Cartesian tree keyed by value with priority $=$ index, the object that makes a random permutation a random treap (Theorem~\ref {thm:c26-randbst}).}}{570}{figure.caption.98}\protected@file@percent }
\newlabel{fig:c26-iso}{{9.4.1}{570}{One array $A=(3,1,4,2)$, three readings. (a) min-Cartesian tree -- inorder $=$ index, heap on value (\defref {c26-cartesian}). (b) the \emph {identical} tree as a treap: keys are the indices $1..4$ (labels here), priorities are the values, root $=$ least-priority key $=2$ (\defref {c06-treap}); (a)$\equiv $(b) is \propref {c26-carters-treap}. (c) is the \emph {other} assignment -- a plain BST built by inserting $3,1,4,2$, which is a Cartesian tree keyed by value with priority $=$ index, the object that makes a random permutation a random treap (\thmref {c26-randbst})}{figure.caption.98}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.4.2}The equivalence}{570}{subsection.9.4.2}\protected@file@percent }
