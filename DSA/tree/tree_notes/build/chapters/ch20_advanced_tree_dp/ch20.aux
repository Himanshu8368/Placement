\newlabel{lst:c20-count}{{15.4.1}{933}{Reroot a count of marked nodes: the parent side of every edge is TOTAL - down[c}{lstlisting.15.4.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {15.4.1}{\ignorespaces Reroot a count of marked nodes: the parent side of every edge is TOTAL - down[c}}{933}{lstlisting.15.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15.4.1}{\ignorespaces Cutting edge $(v,c)$ splits the marks into two rerooted counts, $\mathit  {down}[c]$ (the child subtree, unchanged by re-rooting) and $\mathit  {TOTAL}-\mathit  {down}[c]$ (the parent side -- the up value, free because the combine is a sum). Both numbers land on the same edge, so the two-sided count that CF~1626E's move rule needs is available for \emph  {every} edge in one post-order pass.}}{933}{figure.caption.161}\protected@file@percent }
\newlabel{fig:c20-countfig}{{15.4.1}{933}{Cutting edge $(v,c)$ splits the marks into two rerooted counts, $\mathit {down}[c]$ (the child subtree, unchanged by re-rooting) and $\mathit {TOTAL}-\mathit {down}[c]$ (the parent side -- the up value, free because the combine is a sum). Both numbers land on the same edge, so the two-sided count that CF~1626E's move rule needs is available for \emph {every} edge in one post-order pass}{figure.caption.161}{}}
