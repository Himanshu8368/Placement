\@writefile{lof}{\contentsline {figure}{\numberline {15.3.1}{\ignorespaces The exclusive prefix/suffix aggregate at a node $v$ with children $c_0..c_3$. The top arrow is the forward prefix fold, the bottom the backward suffix fold; combining $\mathit  {pre}[i]$ (children before $i$) with $\mathit  {suf}[i{+}1]$ (children after $i$) yields the fold of \emph  {every} child but $c_i$ in $\ensuremath  {O(1)}$ -- the replacement for ``subtract the child'' when $\Phi $ has no inverse.}}{925}{figure.caption.159}\protected@file@percent }
\newlabel{fig:c20-presuf}{{15.3.1}{925}{The exclusive prefix/suffix aggregate at a node $v$ with children $c_0..c_3$. The top arrow is the forward prefix fold, the bottom the backward suffix fold; combining $\mathit {pre}[i]$ (children before $i$) with $\mathit {suf}[i{+}1]$ (children after $i$) yields the fold of \emph {every} child but $c_i$ in $\bigO {1}$ -- the replacement for ``subtract the child'' when $\Phi $ has no inverse}{figure.caption.159}{}}
