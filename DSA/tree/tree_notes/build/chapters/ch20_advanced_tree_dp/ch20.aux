\@writefile{lof}{\contentsline {figure}{\numberline {15.2.1}{\ignorespaces The pair state at a node. The answer $\mathit  {dp}[v]$ is a node-local combine $\Psi $ of the two independent pieces. Only the up piece is new relative to Chapter~13: to form $\mathit  {up}[c]$ we need $v$'s self-value, $v$'s own up-value, and $c$'s siblings -- and because $\Phi $ is invertible the siblings are $\mathit  {down}[v]\ominus \mathit  {down}[c]$, a single subtraction, not a loop.}}{917}{figure.caption.157}\protected@file@percent }
\newlabel{fig:c20-parentpiece}{{15.2.1}{917}{The pair state at a node. The answer $\mathit {dp}[v]$ is a node-local combine $\Psi $ of the two independent pieces. Only the up piece is new relative to Chapter~13: to form $\mathit {up}[c]$ we need $v$'s self-value, $v$'s own up-value, and $c$'s siblings -- and because $\Phi $ is invertible the siblings are $\mathit {down}[v]\ominus \mathit {down}[c]$, a single subtraction, not a loop}{figure.caption.157}{}}
