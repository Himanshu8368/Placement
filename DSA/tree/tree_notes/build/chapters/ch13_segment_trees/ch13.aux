\@writefile{lof}{\contentsline {figure}{\numberline {19.2.1}{\ignorespaces One merge, on the worked example's state after the first update (\(A=[1,6,-3,5,-1]\)): the left half \(L=[1,6,-3]\) has record \((4,7,4,7)\) and the right half \(R=[5,-1]\) has \((4,5,4,5)\); their merge carries a total of \(8\), best prefix \(9\) (all of \(L\)'s \(4\) plus \(R\)'s prefix \(5\)), best suffix \(8\), and best interior \(9\) -- the crossing block \([1,6,-3,5]\). The tree's \(\mathit  {best}\) is therefore \(9\).}}{1163}{figure.caption.205}\protected@file@percent }
\newlabel{fig:c13-submerge}{{19.2.1}{1163}{One merge, on the worked example's state after the first update (\(A=[1,6,-3,5,-1]\)): the left half \(L=[1,6,-3]\) has record \((4,7,4,7)\) and the right half \(R=[5,-1]\) has \((4,5,4,5)\); their merge carries a total of \(8\), best prefix \(9\) (all of \(L\)'s \(4\) plus \(R\)'s prefix \(5\)), best suffix \(8\), and best interior \(9\) -- the crossing block \([1,6,-3,5]\). The tree's \(\mathit {best}\) is therefore \(9\)}{figure.caption.205}{}}
