\newlabel{thm:c13-descend}{{19.3.1}{1171}{A monotone predicate descends in \(\bigO {\log n}\)}{tcb@cnt@definition.19.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19.3.1}{\ignorespaces One step of a descend. At node \([1..8]\) the left child \([1..4]\)'s aggregate fails the predicate (its running count/sum does not reach the target), so the whole left subtree is discarded \emph  {at once} and we commit to \([5..8]\), subtracting the left's contribution. Three such commits resolve an eight-leaf tree to a leaf -- that is \(\log _2 8=3\) decisions.}}{1172}{figure.caption.207}\protected@file@percent }
\newlabel{fig:c13-descend}{{19.3.1}{1172}{One step of a descend. At node \([1..8]\) the left child \([1..4]\)'s aggregate fails the predicate (its running count/sum does not reach the target), so the whole left subtree is discarded \emph {at once} and we commit to \([5..8]\), subtracting the left's contribution. Three such commits resolve an eight-leaf tree to a leaf -- that is \(\log _2 8=3\) decisions}{figure.caption.207}{}}
