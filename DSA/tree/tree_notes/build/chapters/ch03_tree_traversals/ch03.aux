\@writefile{lof}{\contentsline {figure}{\numberline {3.3.1}{\ignorespaces Level order on $R$ sweeps one band at a time. At the start of processing level $1$ the queue holds exactly that row $\{2,3\}$; freezing \texttt  {sz}$=2$ tells the inner loop to pop two nodes (emitting $2,3$) and enqueue their children $4,5,6$ as the next row. Output: $1$ / $2,3$ / $4,5,6$.}}{190}{figure.caption.42}\protected@file@percent }
\newlabel{fig:c03-bfs}{{3.3.1}{190}{Level order on $R$ sweeps one band at a time. At the start of processing level $1$ the queue holds exactly that row $\{2,3\}$; freezing \code {sz}$=2$ tells the inner loop to pop two nodes (emitting $2,3$) and enqueue their children $4,5,6$ as the next row. Output: $1$ / $2,3$ / $4,5,6$}{figure.caption.42}{}}
