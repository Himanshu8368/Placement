\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.1}Intuition}{202}{subsection.3.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.4.1}{\ignorespaces Reconstruction pivot: preorder names the root ($1$); inorder then splits into the left subtree's inorder ($4,2,5$, size $3$) and right subtree's inorder ($3,6$). The left size tells us the next $3$ preorder tokens ($2,4,5$) belong to the left subtree and the rest to the right -- recurse on both.}}{202}{figure.caption.43}\protected@file@percent }
\newlabel{fig:c03-rebuild}{{3.4.1}{202}{Reconstruction pivot: preorder names the root ($1$); inorder then splits into the left subtree's inorder ($4,2,5$, size $3$) and right subtree's inorder ($3,6$). The left size tells us the next $3$ preorder tokens ($2,4,5$) belong to the left subtree and the rest to the right -- recurse on both}{figure.caption.43}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4.2}{\ignorespaces The (preorder, postorder) ambiguity: two genuinely different trees share both orders. Only a node with \emph  {exactly one} child is ambiguous; if every node has $0$ or $2$ children the pair does determine the tree. Inorder resolves the general case.}}{203}{figure.caption.44}\protected@file@percent }
\newlabel{fig:c03-ambig}{{3.4.2}{203}{The (preorder, postorder) ambiguity: two genuinely different trees share both orders. Only a node with \emph {exactly one} child is ambiguous; if every node has $0$ or $2$ children the pair does determine the tree. Inorder resolves the general case}{figure.caption.44}{}}
