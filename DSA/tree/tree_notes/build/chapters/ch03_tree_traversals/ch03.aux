\@writefile{lof}{\contentsline {figure}{\numberline {3.4.1}{\ignorespaces Two \emph  {different} trees -- root $1$ with a left child $2$ versus with a right child $2$ -- whose preorder is $1,2$ and whose postorder is $2,1$ in both cases. Pre $+$ post agree but the trees differ: exactly one-child nodes are where the ambiguity lives. This is why LeetCode 889 (construct from pre $+$ post) asks for \emph  {any} valid tree.}}{79}{figure.caption.31}\protected@file@percent }
\newlabel{fig:c03-ambig}{{3.4.1}{79}{Two \emph {different} trees -- root $1$ with a left child $2$ versus with a right child $2$ -- whose preorder is $1,2$ and whose postorder is $2,1$ in both cases. Pre $+$ post agree but the trees differ: exactly one-child nodes are where the ambiguity lives. This is why LeetCode 889 (construct from pre $+$ post) asks for \emph {any} valid tree}{figure.caption.31}{}}
