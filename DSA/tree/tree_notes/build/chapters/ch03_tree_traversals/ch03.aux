\@writefile{lof}{\contentsline {figure}{\numberline {3.2.1}{\ignorespaces Mid-inorder on $R$, just before visiting $1$: the explicit stack holds the ancestors whose \emph  {right} child has not been processed. This is exactly what the recursive call frames were storing.}}{175}{figure.caption.40}\protected@file@percent }
\newlabel{fig:c03-stack}{{3.2.1}{175}{Mid-inorder on $R$, just before visiting $1$: the explicit stack holds the ancestors whose \emph {right} child has not been processed. This is exactly what the recursive call frames were storing}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2.2}{\ignorespaces The Morris idea on $R$: to traverse $1$'s left subtree inorder and then return to $1$, temporarily set the inorder predecessor's null \texttt  {right} pointer to $1$. It is undone the moment we return -- the tree is byte-for-byte restored (no permanent change).}}{175}{figure.caption.41}\protected@file@percent }
\newlabel{fig:c03-morris}{{3.2.2}{175}{The Morris idea on $R$: to traverse $1$'s left subtree inorder and then return to $1$, temporarily set the inorder predecessor's null \code {right} pointer to $1$. It is undone the moment we return -- the tree is byte-for-byte restored (no permanent change)}{figure.caption.41}{}}
