\@writefile{lof}{\contentsline {figure}{\numberline {3.4.3}{\ignorespaces The running example $R$, with node $3$'s left child deliberately missing. Plain preorder is $1,2,4,5,3,6$ -- but that same number string is produced by a different tree where $6$ hangs off $3$'s \emph  {left}. Ambiguity lives at exactly such one-child nodes, so a bare order cannot be a serial format.}}{223}{figure.caption.46}\protected@file@percent }
\newlabel{fig:c03-summit-ambig}{{3.4.3}{223}{The running example $R$, with node $3$'s left child deliberately missing. Plain preorder is $1,2,4,5,3,6$ -- but that same number string is produced by a different tree where $6$ hangs off $3$'s \emph {left}. Ambiguity lives at exactly such one-child nodes, so a bare order cannot be a serial format}{figure.caption.46}{}}
