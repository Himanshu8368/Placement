\@writefile{lof}{\contentsline {figure}{\numberline {6.1.1}{\ignorespaces Root detection is \emph  {arithmetic}, not traversal. Read the parent array: the single $0$ marks node~$1$. Or read the directed edge list's in-degrees: the unique $0$ (node~$1$) is the root and every other node is exactly~$1$ -- if any node shows in-degree~$2$, the data is \emph  {not} a rooted tree (that is exactly LC 685's alarm, W\ref {prob:c25-rc2}).}}{361}{figure.caption.24}\protected@file@percent }
\newlabel{fig:c25-rootdetect}{{6.1.1}{361}{Root detection is \emph {arithmetic}, not traversal. Read the parent array: the single $0$ marks node~$1$. Or read the directed edge list's in-degrees: the unique $0$ (node~$1$) is the root and every other node is exactly~$1$ -- if any node shows in-degree~$2$, the data is \emph {not} a rooted tree (that is exactly LC 685's alarm, \probref {c25-rc2})}{figure.caption.24}{}}
