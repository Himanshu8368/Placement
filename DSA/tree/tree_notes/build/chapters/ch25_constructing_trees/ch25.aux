\@writefile{lof}{\contentsline {figure}{\numberline {6.2.1}{\ignorespaces Two arithmetic views of the same degree array. The \emph  {top} row is $T$'s degrees; the $\DOTSB \sum@ \slimits@ =2(n-1)$ test is the whole realisability certificate (Theorem~\ref {thm:c25-degreal}). The \emph  {bottom} row subtracts $1$ from each entry -- its sum is $n-2$, and reading node $v$ exactly $\degop  (v)-1$ times gives the Pr\"ufer \emph  {multiset} $(2,2,1,3,3,7)$ of \S  \ref {sec:c25-parent}'s teaser.}}{371}{figure.caption.25}\protected@file@percent }
\newlabel{fig:c25-degrow}{{6.2.1}{371}{Two arithmetic views of the same degree array. The \emph {top} row is $T$'s degrees; the $\sum =2(n-1)$ test is the whole realisability certificate (\thmref {c25-degreal}). The \emph {bottom} row subtracts $1$ from each entry -- its sum is $n-2$, and reading node $v$ exactly $\degop (v)-1$ times gives the Pr\"ufer \emph {multiset} $(2,2,1,3,3,7)$ of \secref {c25-parent}'s teaser}{figure.caption.25}{}}
