\@writefile{lof}{\contentsline {figure}{\numberline {6.4.1}{\ignorespaces Adaptive halving on a number line. One well-chosen question (the midpoint) turns a size-$10$ candidate set into a size-$\le 5$ one no matter which branch the oracle confirms. Repeating gives a decision \emph  {tree} of depth $\lceil \log _2 n\rceil $ -- exactly the shape the tree chapters draw, but here its nodes are \emph  {questions}, not data.}}{389}{figure.caption.28}\protected@file@percent }
\newlabel{fig:c25-halve}{{6.4.1}{389}{Adaptive halving on a number line. One well-chosen question (the midpoint) turns a size-$10$ candidate set into a size-$\le 5$ one no matter which branch the oracle confirms. Repeating gives a decision \emph {tree} of depth $\lceil \log _2 n\rceil $ -- exactly the shape the tree chapters draw, but here its nodes are \emph {questions}, not data}{figure.caption.28}{}}
