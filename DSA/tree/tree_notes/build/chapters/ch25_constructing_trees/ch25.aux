\@writefile{toc}{\contentsline {section}{\numberline {6.3}Is It a Tree? Identification and a Union-Find Pre-Look}{379}{section.6.3}\protected@file@percent }
\newlabel{sec:c25-identify}{{6.3}{379}{Is It a Tree? Identification and a Union-Find Pre-Look}{section.6.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3.1}Intuition}{380}{subsection.6.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.3.1}{\ignorespaces The three shapes union-find separates. A \textbf  {tree}: $n-1$ edges, every merge accepted. A \textbf  {forest}: acyclic but $<n-1$ edges, several surviving sets. A \textbf  {unicyclic} graph: $n$ edges, the red edge finds its endpoints already joined and is \emph  {rejected} -- the redundant connection (W\ref {prob:c25-rc1}). The number of rejects is the cyclomatic number $e-(n-k)$.}}{381}{figure.caption.27}\protected@file@percent }
\newlabel{fig:c25-shapes}{{6.3.1}{381}{The three shapes union-find separates. A \textbf {tree}: $n-1$ edges, every merge accepted. A \textbf {forest}: acyclic but $<n-1$ edges, several surviving sets. A \textbf {unicyclic} graph: $n$ edges, the red edge finds its endpoints already joined and is \emph {rejected} -- the redundant connection (\probref {c25-rc1}). The number of rejects is the cyclomatic number $e-(n-k)$}{figure.caption.27}{}}
