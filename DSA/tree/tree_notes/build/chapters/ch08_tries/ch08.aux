\@writefile{lof}{\contentsline {figure}{\numberline {11.0.1}{\ignorespaces The trie of $\mathcal  {W}=\{\text  {car},\text  {cares},\text  {care},\text  {cat},\text  {dog}\}$. Each edge is one character; the root is blank ($\cdot $). Only four nodes are green end-of-word markers -- the word \emph  {car} ends at the node $r$ that also continues into \emph  {care}/\emph  {cares}, which is exactly why a ``search'' (must end on a green node) differs from a ``startsWith'' (may stop anywhere): checking \texttt  {care} walks $c$-$a$-$r$-$e$ and sees green, checking \texttt  {car} walks $c$-$a$-$r$ and sees green too, but \texttt  {careful} would walk $c$-$a$-$r$-$e$ and then find no $f$ edge.}}{653}{figure.caption.110}\protected@file@percent }
\newlabel{fig:c08-wordstrie}{{11.0.1}{653}{The trie of $\mathcal {W}=\{\text {car},\text {cares},\text {care},\text {cat},\text {dog}\}$. Each edge is one character; the root is blank ($\cdot $). Only four nodes are green end-of-word markers -- the word \emph {car} ends at the node $r$ that also continues into \emph {care}/\emph {cares}, which is exactly why a ``search'' (must end on a green node) differs from a ``startsWith'' (may stop anywhere): checking \texttt {care} walks $c$-$a$-$r$-$e$ and sees green, checking \texttt {car} walks $c$-$a$-$r$ and sees green too, but \texttt {careful} would walk $c$-$a$-$r$-$e$ and then find no $f$ edge}{figure.caption.110}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.0.2}{\ignorespaces Anatomy of one trie node: a small table mapping each outgoing symbol to a child pointer, plus a single \textbf  {\textcolor {deepblue}{end-of-word}} boolean saying ``a stored key terminates exactly here.'' Nothing about the key is stored \emph  {in} the node -- the key is the \emph  {path} from the root. Swap the table for a fixed \texttt  {child[26]} array, a \texttt  {map}, or a \texttt  {vector<pair<char,node>>} and everything else in this chapter is unchanged (Definition~\ref {def:c08-nodelayout}).}}{653}{figure.caption.111}\protected@file@percent }
\newlabel{fig:c08-triebasics}{{11.0.2}{653}{Anatomy of one trie node: a small table mapping each outgoing symbol to a child pointer, plus a single \term {end-of-word} boolean saying ``a stored key terminates exactly here.'' Nothing about the key is stored \emph {in} the node -- the key is the \emph {path} from the root. Swap the table for a fixed \code {child[26]} array, a \code {map}, or a \code {vector<pair<char,node>>} and everything else in this chapter is unchanged (\defref {c08-nodelayout})}{figure.caption.111}{}}
