\@writefile{lof}{\contentsline {figure}{\numberline {11.3.1}{\ignorespaces The binary trie of $\{3,5,25\}\subset A$ (three of the six values, $5$ bits, MSB at the top). Each node prints the bit taken at that level; the highlighted red root-to-leaf walk is the opposite-bit greedy for querying $x=5$, ending at $25$ and yielding $28$. The full trie of $A$ adds the branches for $10{=}01010$, $2{=}00010$, $8{=}01000$; the production code uses $31$ levels (Code~\ref {lst:c08-maxxor}).}}{678}{figure.caption.114}\protected@file@percent }
\newlabel{fig:c08-bittriefig}{{11.3.1}{678}{The binary trie of $\{3,5,25\}\subset A$ (three of the six values, $5$ bits, MSB at the top). Each node prints the bit taken at that level; the highlighted red root-to-leaf walk is the opposite-bit greedy for querying $x=5$, ending at $25$ and yielding $28$. The full trie of $A$ adds the branches for $10{=}01010$, $2{=}00010$, $8{=}01000$; the production code uses $31$ levels (\coderef {c08-maxxor})}{figure.caption.114}{}}
