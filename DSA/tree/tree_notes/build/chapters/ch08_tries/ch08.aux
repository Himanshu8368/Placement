\@writefile{lof}{\contentsline {figure}{\numberline {11.2.1}{\ignorespaces Word Search II on the official board with words \{oath, pea, eat, rain\}. Left: the green cells trace \textbf  {oath} (o-a-t-h) across adjacent squares; right: a trie of the four words doubles as the live filter -- a grid path that cannot extend a trie edge is abandoned, and reaching a green terminal node reports the word. \textbf  {eat} and \textbf  {oath} are found; \textbf  {pea} and \textbf  {rain} are not traceable.}}{667}{figure.caption.113}\protected@file@percent }
