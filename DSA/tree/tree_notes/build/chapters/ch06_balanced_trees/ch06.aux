\@writefile{lof}{\contentsline {figure}{\numberline {8.3.1}{\ignorespaces Implicit \texttt  {splitPos} cuts a sequence-treap by \emph  {position}, not value: splitting the treap at $\mathit  {cnt}=3$ hands the first three inorder keys $\{1,2,3\}$ to $a$ and $\{4,5,6,7\}$ to $b$, each still a valid treap (Lemma~\ref {lem:c06-mergevalid}). Merging $a$ and $b$ back restores the original -- so ``delete a range'', ``paste after position $k$'', ``reverse $[l,r]$'' are all a split, a local edit, and a merge. This is the dynamic-array superpower of Proposition~\ref {prop:c06-implicit}.}}{502}{figure.caption.87}\protected@file@percent }
\newlabel{fig:c06-splitfig}{{8.3.1}{502}{Implicit \texttt {splitPos} cuts a sequence-treap by \emph {position}, not value: splitting the treap at $\mathit {cnt}=3$ hands the first three inorder keys $\{1,2,3\}$ to $a$ and $\{4,5,6,7\}$ to $b$, each still a valid treap (\lemref {c06-mergevalid}). Merging $a$ and $b$ back restores the original -- so ``delete a range'', ``paste after position $k$'', ``reverse $[l,r]$'' are all a split, a local edit, and a merge. This is the dynamic-array superpower of \propref {c06-implicit}}{figure.caption.87}{}}
