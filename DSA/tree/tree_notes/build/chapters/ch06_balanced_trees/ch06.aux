\@writefile{lof}{\contentsline {figure}{\numberline {8.0.1}{\ignorespaces The villain, $C$: the \emph  {same} set of keys stored as a degenerate chain (left, height $6$) and as a height-balanced tree (right, height $2$). Nothing changes about the \emph  {contents} or the inorder line -- both read $1,2,3,4,5,6,7$ -- only the \emph  {shape}. Balance is the art of moving from left to right and \emph  {staying} there, on every future edit, using the one legal move: the rotation.}}{475}{figure.caption.82}\protected@file@percent }
\newlabel{fig:c06-chain}{{8.0.1}{475}{The villain, $C$: the \emph {same} set of keys stored as a degenerate chain (left, height $6$) and as a height-balanced tree (right, height $2$). Nothing changes about the \emph {contents} or the inorder line -- both read $1,2,3,4,5,6,7$ -- only the \emph {shape}. Balance is the art of moving from left to right and \emph {staying} there, on every future edit, using the one legal move: the rotation}{figure.caption.82}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.0.2}{\ignorespaces The interesting case, $Z$: a Left-Right (zig-zag) violation. When the heavy child leans the \emph  {opposite} way, one rotation only converts the problem into a single-side case -- you need \emph  {two}: a rotation on the child first, then on the anchor. Both figures keep the identical sorted inorder; this is the crux of Theorem~\ref {thm:c06-rotation}.}}{475}{figure.caption.83}\protected@file@percent }
\newlabel{fig:c06-zigzag}{{8.0.2}{475}{The interesting case, $Z$: a Left-Right (zig-zag) violation. When the heavy child leans the \emph {opposite} way, one rotation only converts the problem into a single-side case -- you need \emph {two}: a rotation on the child first, then on the anchor. Both figures keep the identical sorted inorder; this is the crux of \thmref {c06-rotation}}{figure.caption.83}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.1}Why Balance? The Rotation}{478}{section.8.1}\protected@file@percent }
\newlabel{sec:c06-rotations}{{8.1}{478}{Why Balance? The Rotation}{section.8.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.1.1}Intuition}{479}{subsection.8.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8.1.1}{\ignorespaces A left rotation about $x$ (right child $y$): $y$ is promoted to $x$'s former spot, $x$ becomes $y$'s left child, and $y$'s old left subtree $B$ is handed down to become $x$'s right child. Exactly three subtree pointers move; the inorder sequence $A,x,B,y,C$ is preserved verbatim, which is Theorem~\ref {thm:c06-rotation}. A right rotation is the exact mirror image.}}{479}{figure.caption.85}\protected@file@percent }
\newlabel{fig:c06-rot}{{8.1.1}{479}{A left rotation about $x$ (right child $y$): $y$ is promoted to $x$'s former spot, $x$ becomes $y$'s left child, and $y$'s old left subtree $B$ is handed down to become $x$'s right child. Exactly three subtree pointers move; the inorder sequence $A,x,B,y,C$ is preserved verbatim, which is \thmref {c06-rotation}. A right rotation is the exact mirror image}{figure.caption.85}{}}
