# rough notes stay untracked; only the greedy book's sources are tracked
/notes/*
!/notes/greedy_book/

# greedy book build outputs
/notes/greedy_book/**/*.aux
/notes/greedy_book/**/*.log
/notes/greedy_book/**/*.out
/notes/greedy_book/**/*.toc
/notes/greedy_book/**/*.pdf
/notes/greedy_book/**/*.synctex.gz
/notes/greedy_book/**/*.fls
/notes/greedy_book/**/*.fdb_latexmk
/notes/greedy_book/**/*.exe
/notes/greedy_book/**/__pycache__/
/notes/greedy_book/tools/.lc_slugs.json
