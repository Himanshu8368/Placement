# rough notes stay untracked; only the binary search book's sources are tracked
/notes/*
!/notes/bs_book/

# binary search book build outputs
/notes/bs_book/**/*.aux
/notes/bs_book/**/*.log
/notes/bs_book/**/*.out
/notes/bs_book/**/*.toc
/notes/bs_book/**/*.pdf
/notes/bs_book/**/*.synctex.gz
/notes/bs_book/**/*.fls
/notes/bs_book/**/*.fdb_latexmk
/notes/bs_book/**/*.exe
/notes/bs_book/**/__pycache__/
/notes/bs_book/tools/.lc_slugs.json
