# rough notes stay untracked; only the bit book's sources are tracked
/notes/*
!/notes/bit_book/

# bit book build outputs
/notes/bit_book/**/*.aux
/notes/bit_book/**/*.log
/notes/bit_book/**/*.out
/notes/bit_book/**/*.toc
/notes/bit_book/**/*.pdf
/notes/bit_book/**/*.synctex.gz
/notes/bit_book/**/*.fls
/notes/bit_book/**/*.fdb_latexmk
/notes/bit_book/**/*.exe
/notes/bit_book/**/__pycache__/
/notes/bit_book/tools/.lc_slugs.json
