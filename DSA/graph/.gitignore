# rough notes stay untracked; only the graph book's sources are tracked
/notes/*
!/notes/graph_book/

# graph book build outputs
/notes/graph_book/**/*.aux
/notes/graph_book/**/*.log
/notes/graph_book/**/*.out
/notes/graph_book/**/*.toc
/notes/graph_book/**/*.pdf
/notes/graph_book/**/*.synctex.gz
/notes/graph_book/**/*.fls
/notes/graph_book/**/*.fdb_latexmk
/notes/graph_book/**/*.exe
/notes/graph_book/**/__pycache__/
/notes/graph_book/**/.sample_cache/
